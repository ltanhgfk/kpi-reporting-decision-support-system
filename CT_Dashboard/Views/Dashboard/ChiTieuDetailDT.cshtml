@model List<CT_Dashboard.Models.ChiTieuDetailViewModel>

@{
    ViewBag.Title = "Chi tiết chỉ tiêu: " + (ViewBag.TenChiTieu ?? "");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- DataTables CSS -->
<link href="@Url.Content("~/Content/assets/css/dataTables.bootstrap5.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/Content/assets/css/responsive.bootstrap5.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/Content/assets/css/buttons.bootstrap5.min.css")" rel="stylesheet" />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title mb-0">
                            <i class="mdi mdi-chart-line text-primary"></i>
                            Chi tiết chỉ tiêu: @ViewBag.TenChiTieu
                        </h4>
                        <small class="text-muted">Mã chỉ tiêu: @ViewBag.MaChiTieu</small>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.close()">
                            <i class="mdi mdi-close"></i> Đóng
                        </button>
                        <a href="@Url.Action("Dashboard", "Dashboard")" class="btn btn-primary btn-sm">
                            <i class="mdi mdi-arrow-left"></i> Quay lại Dashboard
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <strong>Thông báo:</strong> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    else if (Model != null && Model.Any())
                    {
                        <!-- Thống kê tổng quan -->
                        <div class="row mb-4">
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-primary text-white">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">Tổng thực hiện</h6>
                                                <h4 class="mb-0" id="tongThucHien">@Model.Sum(x => x.ThucHien).ToString("N0")</h4>
                                            </div>
                                            <div class="flex-shrink-0">
                                                <i class="mdi mdi-trending-up font-size-24"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">Tổng kế hoạch</h6>
                                                <h4 class="mb-0" id="tongKeHoach">@Model.Sum(x => x.KeHoach).ToString("N0")</h4>
                                            </div>
                                            <div class="flex-shrink-0">
                                                <i class="mdi mdi-target font-size-24"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-info text-white">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">Tỷ lệ đạt (%)</h6>
                                                <h4 class="mb-0" id="tyLeDat">
                                                    @{
                                                        var tongKeHoach = Model.Sum(x => x.KeHoach);
                                                        var tongThucHien = Model.Sum(x => x.ThucHien);
                                                        var tyLe = tongKeHoach != 0 ? Math.Round((double)tongThucHien * 100 / tongKeHoach, 2) : 0;
                                                    }
                                                    @tyLe%
                                                </h4>
                                            </div>
                                            <div class="flex-shrink-0">
                                                <i class="mdi mdi-percent font-size-24"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-warning text-white">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">Số đơn vị báo cáo</h6>
                                                <h4 class="mb-0" id="soDonVi">@Model.Count()</h4>
                                            </div>
                                            <div class="flex-shrink-0">
                                                <i class="mdi mdi-file-document font-size-24"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Filter và Pagination theo tháng -->
                        <div class="row mb-3">
                            <!-- <div class="col-md-6">
                                <div id="chiTieuDetailTable_filter" class="dataTables_filter">
                                    <label>Tìm kiếm:<input type="search" class="form-control form-control-sm" placeholder="" aria-controls="chiTieuDetailTable" id="customSearch"></label>
                                </div>
                            </div>-->
                            <div class="col-md-12">
                                <div class="d-flex justify-content-end">
                                    <div class="month-pagination">
                                        <!-- <small class="text-muted me-2">Lọc theo tháng:</small>-->
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-outline-primary btn-sm month-filter active" data-month="all">
                                                Tất cả
                                            </button>
                                            @for (int i = 1; i <= 12; i++)
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-sm month-filter" data-month="@i">
                                                    Tháng @i
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                        </div>

                        <!-- Bảng chi tiết -->
                        <div class="table-responsive">
                            <table id="chiTieuDetailTable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                                <thead class="table-dark">
                                    <tr>
                                        <th>STT</th>
                                        <th>Địa bàn</th>
                                        <th>Đơn vị</th>
                                        <th>Tháng/Năm</th>
                                        <th class="text-wrap">Ngày báo cáo</th>
                                        <th class="text-wrap">Thực hiện trong kỳ</th>
                                        <th class="text-wrap">Thực hiện lũy kế</th>
                                        <th class="text-wrap">Kế hoạch</th>
                                        <th class="text-wrap">Còn lại</th>
                                        <th>Tỷ lệ (%)</th>
                                        <th class="text-wrap">Cùng kỳ</th>
                                        <th class="text-wrap">So với cùng kỳ (%)</th>
                                        <th>Trạng thái</th>
                                        <th>Đơn vị tính</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{var index = 1;}
                                    @foreach (var item in Model)
                                    {
                                        <tr data-month="@item.Thang">
                                            <td>@index</td>
                                            <td class="text-wrap">@item.TenDiaBan</td>
                                            <td>@item.DonVi</td>
                                            <td>@item.Thang/@item.Nam</td>
                                            <td>@item.NgayBaoCao.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end text-wrap">@item.ThucHienTrongKy.ToString("N0")</td>
                                            <td class="text-end text-wrap">@item.ThucHien.ToString("N0")</td>
                                            <td class="text-end">@item.KeHoach.ToString("N0")</td>
                                            <td class="text-end @(item.ConLai > 0 ? "text-warning" : "text-success")">@item.ConLai.ToString("N0")</td>
                                            <td class="text-end">
                                                <span class="badge @(item.TyLeHoanThanh >= 100 ? "bg-success" : item.TyLeHoanThanh >= 80 ? "bg-info" : item.TyLeHoanThanh >= 50 ? "bg-warning" : "bg-danger")">
                                                    @item.TyLeHoanThanh.ToString("F2")%
                                                </span>
                                            </td>
                                            <td class="text-end">@item.CungKy.ToString("N0")</td>
                                            <td class="text-end @(item.SoVoiCungKy >= 0 ? "text-success" : "text-danger")">
                                                @(item.SoVoiCungKy > 0 ? "+" : "")@item.SoVoiCungKy.ToString("F2")%
                                            </td>
                                            <td class="text-wrap">
                                                <span class="@item.CssClassTrangThai">
                                                    <i class="mdi @(item.TyLeHoanThanh >= 100 ? "mdi-check-circle" : item.TyLeHoanThanh >= 80 ? "mdi-clock-outline" : item.TyLeHoanThanh >= 50 ? "mdi-alert-outline" : "mdi-close-circle")"></i>
                                                    @item.TrangThaiHoanThanh
                                                </span>
                                            </td>
                                            <td>@item.DonViTinh</td>
                                            <td class="text-wrap">@(string.IsNullOrEmpty(item.GhiChu) ? "" : item.GhiChu)</td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center" role="alert">
                            <i class="mdi mdi-information-outline font-size-24"></i>
                            <h5 class="mt-2">Không có dữ liệu</h5>
                            <p class="mb-0">Hiện tại chưa có dữ liệu cho chỉ tiêu này.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables JS -->
    <script src="@Url.Content("~/Content/assets/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/responsive.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/buttons.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/vfs_fonts.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/buttons.print.min.js")"></script>

    <script>
        $(document).ready(function () {
            var table = $('#chiTieuDetailTable').DataTable({
                responsive: true,
                dom: 'Brtip', // Bỏ 'f' để ẩn search box mặc định
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="mdi mdi-file-excel"></i> Excel',
                        className: 'btn btn-success btn-sm'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="mdi mdi-file-pdf"></i> PDF',
                        className: 'btn btn-danger btn-sm'
                    },
                    {
                        extend: 'print',
                        text: '<i class="mdi mdi-printer"></i> In',
                        className: 'btn btn-info btn-sm'
                    }
                ],
                language: {
                    "sEmptyTable": "Không có dữ liệu trong bảng",
                    "sInfo": "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                    "sInfoEmpty": "Hiển thị 0 đến 0 của 0 dòng",
                    "sInfoFiltered": "(được lọc từ _MAX_ dòng)",
                    "sLengthMenu": "Hiển thị _MENU_ dòng",
                    "sLoadingRecords": "Đang tải...",
                    "sProcessing": "Đang xử lý...",
                    "sSearch": "Tìm kiếm:",
                    "sZeroRecords": "Không tìm thấy kết quả",
                    "oPaginate": {
                        "sFirst": "Đầu",
                        "sLast": "Cuối",
                        "sNext": "Tiếp",
                        "sPrevious": "Trước"
                    }
                },
                pageLength: 25,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "Tất cả"]],
                order: [[3, 'desc'], [1, 'asc']], // Sắp xếp theo tháng/năm giảm dần, sau đó theo địa bàn tăng dần
                columnDefs: [
                    { targets: [5, 6, 7, 8, 10], className: 'text-end' }, // Căn phải các cột số
                    { targets: [9, 11], className: 'text-center' }, // Căn giữa cột tỷ lệ
                    { targets: [12], className: 'text-center' }, // Căn giữa cột trạng thái
                    { targets: [0], orderable: false } // Không cho phép sắp xếp cột STT
                ]
            });

            // Custom search box
            $('#customSearch').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Month filter functionality
            $('.month-filter').on('click', function () {
                var selectedMonth = $(this).data('month');
                
                // Update active state
                $('.month-filter').removeClass('active');
                $(this).addClass('active');
                
                // Filter table
                if (selectedMonth === 'all') {
                    table.column(3).search('').draw();
                } else {
                    // Search for rows that contain the selected month
                    table.column(3).search('^' + selectedMonth + '/', true, false).draw();
                }
                
                // Update statistics
                updateStatistics(selectedMonth);
                
                // Update STT column
                updateSTT();
            });

            function updateStatistics(month) {
                var tongThucHien = 0;
                var tongKeHoach = 0;
                var soDonVi = 0;
                
                table.rows({ search: 'applied' }).every(function (rowIdx, tableLoop, rowLoop) {
                    var data = this.data();
                    var thucHien = parseFloat(data[6].replace(/[^\d.-]/g, '')) || 0;
                    var keHoach = parseFloat(data[7].replace(/[^\d.-]/g, '')) || 0;
                    
                    tongThucHien += thucHien;
                    tongKeHoach += keHoach;
                    soDonVi++;
                });
                
                var tyLe = tongKeHoach !== 0 ? Math.round((tongThucHien * 100) / tongKeHoach * 100) / 100 : 0;
                
                $('#tongThucHien').text(tongThucHien.toLocaleString('vi-VN'));
                $('#tongKeHoach').text(tongKeHoach.toLocaleString('vi-VN'));
                $('#tyLeDat').text(tyLe + '%');
                $('#soDonVi').text(soDonVi);
            }

            function updateSTT() {
                var counter = 1;
                table.rows({ search: 'applied' }).every(function (rowIdx, tableLoop, rowLoop) {
                    var cell = this.cell(rowIdx, 0);
                    cell.data(counter);
                    counter++;
                });
                table.draw(false);
            }

            // Initialize STT on page change
            table.on('draw', function () {
                updateSTT();
            });
        });
    </script>
}

@section Styles {
    <style>
        .card {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .table-responsive {
            border-radius: 8px;
            overflow: hidden;
        }

        .badge {
            font-size: 0.75em;
            padding: 0.375rem 0.75rem;
        }

        .btn-outline-secondary:hover {
            color: #fff;
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.375rem 0.75rem;
            margin: 0 0.125rem;
            border-radius: 0.25rem;
        }

        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
            padding: 0.375rem 0.75rem;
        }

        .dt-buttons {
            margin-bottom: 1rem;
        }

        .dt-button {
            margin-right: 0.5rem !important;
            border-radius: 0.25rem !important;
        }

        .month-pagination {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
        }

        .month-filter {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            margin: 0 1px;
        }

        .month-filter.active {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }

        .btn-group .btn {
            border-radius: 0;
        }

        .btn-group .btn:first-child {
            border-top-left-radius: 0.25rem;
            border-bottom-left-radius: 0.25rem;
        }

        .btn-group .btn:last-child {
            border-top-right-radius: 0.25rem;
            border-bottom-right-radius: 0.25rem;
        }

        @@media (max-width: 768px) {
            .card-header {
                flex-direction: column;
                align-items: flex-start !important;
            }

            .card-header > div:last-child {
                margin-top: 1rem;
                width: 100%;
            }

            .month-pagination {
                margin-top: 1rem;
            }

            .btn-group {
                flex-wrap: wrap;
            }

            .month-filter {
                margin-bottom: 0.25rem;
            }
        }
    </style>
}