@{
    ViewBag.Title = "Nhập địa bàn";
}

<div class="container">
    <h2 class="text-center">NHẬP ĐỊA BÀN TỪ EXCEL</h2>
    @*<p>
        @Html.ActionLink("Tải file mẫu", "DownloadSample", null, new { @class = "btn btn-info" })
    </p>*@

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">@ViewBag.Success</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

<form action="@Url.Action("Import")" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Chọn file Excel</label>
        <input type="file" name="file" class="form-control" accept=".xlsx" />
    </div>
    <button type="submit" class="btn btn-primary">Tải lên</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
</form>
    </div>

    @section styles {
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="../Content/assets/css/style.css">
    }
