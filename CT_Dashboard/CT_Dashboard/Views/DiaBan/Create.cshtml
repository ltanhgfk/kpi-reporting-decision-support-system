@model CT_Dashboard.Models.DIA_BAN
@{
    ViewBag.Title = "Thêm địa bàn";
}
<div class="container">
    <h2 class="text-center">THÊM ĐỊA BÀN</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.MA_DIA_BAN, "Mã địa bàn")
                @Html.EditorFor(model => model.MA_DIA_BAN, new { htmlAttributes = new { @class = "form-control", maxlength = "25" } })
                @Html.ValidationMessageFor(model => model.MA_DIA_BAN, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.TEN_DIA_BAN, "Tên địa bàn")
                @Html.EditorFor(model => model.TEN_DIA_BAN, new { htmlAttributes = new { @class = "form-control", maxlength = "200" } })
                @Html.ValidationMessageFor(model => model.TEN_DIA_BAN, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.VI_TRI, "Vị trí")
                @Html.EditorFor(model => model.VI_TRI, new { htmlAttributes = new { @class = "form-control", @type = "number", min = "0", max = "255" } })
                @Html.ValidationMessageFor(model => model.VI_TRI, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.TRANG_THAI, "Trạng thái")
                @Html.DropDownList("TRANG_THAI",
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Hoạt động", Value = "Active" },
                        new SelectListItem { Text = "Tạm ngưng", Value = "Inactive" },
                        new SelectListItem { Text = "Ngừng", Value = "Temp" }
                    },
                    "-- Chọn trạng thái --",
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TRANG_THAI, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <div class="form-check">
                    @Html.CheckBox("QUAN_TRONG", false, new { @class = "form-check-input", id = "QUAN_TRONG" })
                    @Html.Label("QUAN_TRONG", "Hiển thị trên Dashboard", new { @class = "form-check-label" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Thêm" class="btn btn-primary" />
                    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    }
</div>

@section styles {
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="../Content/assets/css/style.css">
}