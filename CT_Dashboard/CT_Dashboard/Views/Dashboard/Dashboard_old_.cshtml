        <!-- Back to Top button styles -->
        <style>
            #back-to-top {
                display: none;
                position: fixed;
                bottom: 20px;
                right: 20px;
                z-index: 1000;
                padding: 10px;
                border-radius: 50%;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s, transform 0.3s;
            }

                #back-to-top:hover {
                    opacity: 0.8;
                    transform: scale(1.1);
                }

            /* Styles cho các link chi tiết */
            .card-title:hover,
            tr:hover {
