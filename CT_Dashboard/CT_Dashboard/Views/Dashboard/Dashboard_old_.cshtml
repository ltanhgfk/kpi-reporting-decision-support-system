                                                @{
                                                    <span class="fs-30 mb-2">@item.ThucHien.ToString("N0", nfi) </span> @item.DonViTinh
                                                }
                                            </p>
                                            <div>
                                                @{
                                                    var dienGiai = item.DienGiai ?? "";
                                                    var hasMoreText = dienGiai.Length > 40;
                                                    var shortText = hasMoreText ? dienGiai.Substring(0, 40) + "..." : dienGiai;
                                                    var fullId = "full_" + item.MaChiTieu;
                                                    var shortId = "short_" + item.MaChiTieu;
                                                }

                                                <div id="@shortId">
