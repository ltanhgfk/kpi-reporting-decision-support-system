@using System.Linq;
@using System.Globalization;
@using CT_Dashboard.Models;

@{
    ViewBag.Title = "Báo cáo kết quả thực hiện nhiệm vụ, công tác thuế";
    Layout = "~/Views/Shared/_Layout.cshtml";
    CT_DASHBOARDEntities _db = new CT_DASHBOARDEntities();
    var NhomChiTieu = ViewBag.NhomChiTieu as List<CT_Dashboard.Models.ChiTieuViewModel>;
    var i = 0;

    var TongThuNoiDia = ViewBag.TTND as BaoCaoViewModel;
    var labelTongThu = new[] { "Thực hiện", "Còn lại" };
    var valueTongThu = TongThuNoiDia != null ? new[] { TongThuNoiDia.ThucHien, TongThuNoiDia.Conlai } : new[] { 0D, 0D };

    var TTRU = ViewBag.TTRU as BaoCaoViewModel;
    var labelTTRU = new[] { "Thực hiện", "Còn lại" };
    var valueTTRU = TTRU != null ? new[] { TTRU.ThucHien, TTRU.Conlai } : new[] { 0D, 0D };

    var ChiTieuAll = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.ChiTieuAll;
    var labelCTAll = ChiTieuAll.Select(x => x.TenChiTieu).ToArray();
    var thuchienCTAll = ChiTieuAll.Select(x => x.ThucHien).ToArray();
    var kehoachCTAll = ChiTieuAll.Select(x => x.KeHoach).ToArray();
    var cungkyCTAll = ChiTieuAll.Select(x => x.CungKy).ToArray();

    var DonViAll = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.DonViAll;
    var labelDVAll = DonViAll.Select(x => x.MaDiaBan).ToArray();
    var thuchienDVAll = DonViAll.Select(x => x.ThucHien).ToArray();
    var kehoachDVAll = DonViAll.Select(x => x.KeHoach).ToArray();
    var cungkyDVAll = DonViAll.Select(x => x.CungKy).ToArray();

    var NgayBaoCaoDT = TongThuNoiDia?.NgaySoLieu?.ToString("dd/MM/yyyy") ?? "";

    var colors = new[] { "bg-primary", "bg-success", "bg-info", "bg-warning", "bg-danger", "bg-secondary", "bg-dark" };
    var random = new Random();

    var DN = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.DN;
    var HT = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.HT;
    var KT = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.KT;
    var NO = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.NO;
    var HD = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.HD;
    var CN = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.CN;
    var HC = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.HC;

    var NgayBCQLDN = ViewBag.NgayBCQLDN;
    var NgayBCKT = ViewBag.NgayBCKT;
    var NgayBCCNTK = ViewBag.NgayBCCNTK;
    var NgayBCVP = ViewBag.NgayBCVP;

    CultureInfo culture = new CultureInfo("vi-VN");
    NumberFormatInfo nfi = culture.NumberFormat;
}

<script src="@Url.Content("~/Content/assets/js/jquery-3.6.0.min.js")"></script>
<script src="@Url.Content("~/Content/assets/js/chart.js@4.4.0.js")"></script>
<script src="@Url.Content("~/Content/assets/js/chartjs-plugin-datalabels@2.2.0.js")"></script>
<link href="@Url.Content("~/Content/assets/css/dataTables.bootstrap5.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/Content/assets/js/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/Content/assets/js/dataTables.bootstrap5.min.js")"></script>
<script src="@Url.Content("~/Content/assets/js/mychart.js")"></script>

<!-- partial -->
<div class="container-fluid page-body-wrapper">
    <!-- partial:partials/_sidebar.html -->
    <nav class="sidebar sidebar-offcanvas" id="sidebar">
        <ul class="nav">
            <li class="nav-item">
                <a class="nav-link" href="#dashboard-section">
                    <i class="icon-grid menu-icon"></i>
                    <span class="menu-title">Dashboard</span>
                </a>
            </li>
            @foreach (var nct in NhomChiTieu)
            {
                i = i + 1;
                var sectionId = "section-" + nct.MaChiTieu;
                <li class="nav-item">
                    <a class="nav-link" href="#@sectionId">
                        <i class="icon-grid menu-icon"></i>
                        <span class="menu-title">@nct.TenChiTieu</span>
                        <i class="menu-arrow"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div class="main-panel">
        <div class="content-wrapper">
            <div class="row" id="dashboard-section">
                <div class="col-md-12 grid-margin">
                    <div class="row">
                        <div class="col-9 col-xl-9 mb-4 mb-xl-0">
                            <h3 class="font-weight-bold">KẾT QUẢ THỰC HIỆN NHIỆM VỤ CÔNG TÁC THUẾ</h3>
                            <h6 class="font-weight-normal mb-0 text-primary"></h6>
                        </div>
                        <div class="col-3 col-xl-3">
                            <div class="justify-content-end d-flex">
                                <div class="dropdown flex-md-grow-1 flex-xl-grow-0">
                                    <script>
                                        document.addEventListener("DOMContentLoaded", function () {
                                            const today = new Date();
                                            const options = { day: '2-digit', month: 'short', year: 'numeric' };
                                            const formattedDate = today.toLocaleDateString('en-GB', options).replace(/ /g, ' ');
                                            document.getElementById("dropdownMenuDate2").innerText = `Today (${formattedDate})`;
                                        });
                                    </script>
                                    <button class="btn btn-sm btn-light bg-white dropdown-toggle" type="button" id="dropdownMenuDate2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Phần các biểu đồ tổng quan -->
            <div class="row" id="section-DT">
                <div class="col-md-12 grid-margin stretch-card">
                    <div class="card position-relative">
                        <div class="card-body">
                            <div class="carousel slide detailed-report-carousel position-static pt-2" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <div class="row">
                                            <div class="col-md-12 col-xl-12">
                                                <div class="row">
                                                    <div class="col-md-4 mt-3 border-right">
                                                        <!-- Link chi tiết cho biểu đồ tròn -->
                                                        <div style="cursor: pointer;" onclick="viewChiTieuDetailDT('@(TongThuNoiDia?.MaChiTieu ?? "")')">
                                                            <canvas id="chartTongThu"></canvas>
                                                        </div>
                                                        @{
                                                            var title = TongThuNoiDia != null ? $"{TongThuNoiDia.TenChiTieu} ({NgayBaoCaoDT})" : "";
                                                        }
                                                        <script>
                                                            var title = @Html.Raw(Json.Encode(title));
                                                            var chartLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(labelTongThu));
                                                            var chartValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(valueTongThu));
                                                            var mycolors = ['#36A2EB', '#FF6384'];
                                                        </script>
                                                        <script>
                                                            renderDonutChart(chartLabels, chartValues, 'chartTongThu', title, mycolors);
                                                        </script>
                                                    </div>

                                                    <div class="col-md-8">
                                                        @*<h6 class="card-title mb-0 text-center" style="cursor: pointer; color: #007bff; font-weight: bold; padding: 10px;" onclick="showDiaBanDetail()" title="Click để xem chi tiết theo địa bàn">
                                                                Thu ngân sách theo từng địa bàn quản lý (@NgayBaoCaoDT)
                                                                <i class="mdi mdi-open-in-new" style="font-size: 16px; margin-left: 5px;"></i>
                                                            </h6>*@
                                                        <div style="cursor: pointer;" onclick="showDiaBanDetail()">
                                                            <canvas id="chartDonViAll"></canvas>
                                                        </div>

                                                        <script>
                                                            var label_DV = @Html.Raw(Json.Encode(labelDVAll));
                                                            var thuchien_DV = @Html.Raw(Json.Encode(thuchienDVAll));
                                                            var kehoach_DV = @Html.Raw(Json.Encode(kehoachDVAll));
                                                            var cungky_DV = @Html.Raw(Json.Encode(cungkyDVAll));
                                                            var title_DV = @Html.Raw(Json.Encode("Thu ngân sách theo từng địa bàn quản lý " + "(" + NgayBaoCaoDT + ")"));
                                                            var xTitle = "Địa bàn";
                                                            var yTitle = "Số thu";
                                                        </script>
                                                        <script>
                                                            renderLineChart('chartDonViAll', label_DV, thuchien_DV, kehoach_DV, cungky_DV, title_DV, xTitle, yTitle);
                                                        </script>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" id="section-DT0">
