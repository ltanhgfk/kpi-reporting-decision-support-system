    @section scripts {
        <script src="@Url.Content("~/Content/assets/js/jquery-3.6.0.min.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/chart.js@4.4.0.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/chart.js")"></script>
        <script src="@Url.Content("~/Content/assets/vendors/js/vendor.bundle.base.js")"></script>
        <script src="@Url.Content("~/Content/assets/vendors/chart.js/chart.umd.js")"></script>
        <script src="@Url.Content("~/Content/assets/vendors/datatables.net/jquery.dataTables.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/dataTables.bootstrap5.min.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/dataTables.select.min.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/off-canvas.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/template.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/settings.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/todolist.js")"></script>
        <script src="@Url.Content("~/Content/assets/js/jquery.cookie.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Content/assets/js/dashboard.js")"></script>

        <!-- JavaScript functions để xử lý navigation tới trang chi tiết -->
        <script>

            function showMore(maChiTieu) {
                document.getElementById('short_' + maChiTieu).style.display = 'none';
                document.getElementById('full_' + maChiTieu).style.display = 'block';
            }

            function showLess(maChiTieu) {
                document.getElementById('full_' + maChiTieu).style.display = 'none';
                document.getElementById('short_' + maChiTieu).style.display = 'block';
            }

        // Function để hiển thị chi tiết theo địa bàn (mở tab mới)
        function showDiaBanDetail() {
            window.open('@Url.Action("DetailDiaBan", "Dashboard")', '_blank');
        }

        // Function để hiển thị chi tiết theo nguồn thu (mở tab mới)
        function showChiTieuDetail() {
            window.open('@Url.Action("DetailChiTieu", "Dashboard")', '_blank');
        }       

        // Function để chuyển đến trang chi tiết của một chỉ tiêu cụ thể
        function viewChiTieuDetail(maChiTieu) {
            if (maChiTieu && maChiTieu.trim() !== '') {
                window.open('@Url.Action("ChiTieuDetail", "Dashboard")?maChiTieu=' + encodeURIComponent(maChiTieu), '_blank');
            }
        }

            // Function để chuyển đến trang chi tiết của một chỉ tiêu cụ thể
        function viewChiTieuDetailDT(maChiTieu) {
            if (maChiTieu && maChiTieu.trim() !== '') {
                window.open('@Url.Action("ChiTieuDetailDT", "Dashboard")?maChiTieu=' + encodeURIComponent(maChiTieu), '_blank');
            }
        }

        // Function để chuyển đến trang chi tiết của một nhóm chỉ tiêu
        function viewNhomChiTieuDetail(nhomChiTieu) {
            if (nhomChiTieu && nhomChiTieu.trim() !== '') {
                window.open('@Url.Action("NhomChiTieuDetail", "Dashboard")?nhomChiTieu=' + encodeURIComponent(nhomChiTieu), '_blank');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Smooth scrolling for menu items
            const navLinks = document.querySelectorAll('.nav-link[data-section]');
            navLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    const sectionId = this.getAttribute('data-section');
                    const section = document.getElementById(sectionId);
                    if (section) {
                        e.preventDefault();
                        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            // Back to Top functionality
            const backToTopButton = document.getElementById('back-to-top');
            backToTopButton.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // Show/hide Back to Top button based on scroll position
            window.addEventListener('scroll', function () {
                if (window.scrollY > 300) {
                    backToTopButton.style.display = 'block';
                } else {
                    backToTopButton.style.display = 'none';
                }
            });
        });
        </script>
    }

