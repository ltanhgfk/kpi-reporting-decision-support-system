                cursor: pointer;
            }

            /* Responsive design improvements */
            @@media (max-width: 768px) {
                .card-title {
                    font-size: 0.9rem;
                }

                .chart-container {
                    margin-bottom: 20px;
                }
            }
        </style>
    }
