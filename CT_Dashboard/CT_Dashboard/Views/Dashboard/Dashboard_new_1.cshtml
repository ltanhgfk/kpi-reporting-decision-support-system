@using System.Linq;
@using System.Globalization;
@using CT_Dashboard.Models;

@{
    ViewBag.Title = "Báo cáo kết quả thực hiện nhiệm vụ, công tác thuế";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var NhomChiTieu = ViewBag.NhomChiTieu as List<CT_Dashboard.Models.ChiTieuViewModel>;
    var i = 0;

    var TongThuNoiDia = ViewBag.TTND as BaoCaoViewModel;
    var labelTongThu = new[] { "Thực hiện", "Còn lại" };
    var valueTongThu = TongThuNoiDia != null ? new[] { TongThuNoiDia.ThucHien, TongThuNoiDia.Conlai } : new[] { 0D, 0D };

    var TTRU = ViewBag.TTRU as BaoCaoViewModel;
    var labelTTRU = new[] { "Thực hiện", "Còn lại" };
    var valueTTRU = TTRU != null ? new[] { TTRU.ThucHien, TTRU.Conlai } : new[] { 0D, 0D };

    var ChiTieuAll = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.ChiTieuAll;
    var labelCTAll = ChiTieuAll.Select(x => x.TenChiTieu).ToArray();
    var thuchienCTAll = ChiTieuAll.Select(x => x.ThucHien).ToArray();
    var kehoachCTAll = ChiTieuAll.Select(x => x.KeHoach).ToArray();
    var cungkyCTAll = ChiTieuAll.Select(x => x.CungKy).ToArray();

    var DonViAll = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.DonViAll;
    var labelDVAll = DonViAll.Select(x => x.MaDiaBan).ToArray();
    var thuchienDVAll = DonViAll.Select(x => x.ThucHien).ToArray();
    var kehoachDVAll = DonViAll.Select(x => x.KeHoach).ToArray();
    var cungkyDVAll = DonViAll.Select(x => x.CungKy).ToArray();

    var NgayBaoCaoDT = TongThuNoiDia?.NgaySoLieu?.ToString("dd/MM/yyyy") ?? "";

    var DN = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.DN;
    var HT = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.HT;
    var KT = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.KT;
    var NO = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.NO;
    var HD = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.HD;
    var CN = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.CN;
    var HC = (List<CT_Dashboard.Models.BaoCaoViewModel>)ViewBag.HC;

    var NgayBCQLDN = ViewBag.NgayBCQLDN;
    var NgayBCKT = ViewBag.NgayBCKT;
    var NgayBCCNTK = ViewBag.NgayBCCNTK;
    var NgayBCVP = ViewBag.NgayBCVP;

    // Tháng/Năm hiện tại từ dữ liệu
    var currentThang = ViewBag.CurrentThang ?? (TongThuNoiDia?.NgaySoLieu?.Month ?? DateTime.Now.Month);
    var currentNam = ViewBag.CurrentNam ?? (TongThuNoiDia?.NgaySoLieu?.Year ?? DateTime.Now.Year);

    CultureInfo culture = new CultureInfo("vi-VN");
    NumberFormatInfo nfi = culture.NumberFormat;
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/bootstrap.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/feather/feather.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/ti-icons/css/themify-icons.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/css/vendor.bundle.base.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/font-awesome/css/font-awesome.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/mdi/css/materialdesignicons.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/dataTables.bootstrap5.min.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/assets/js/select.dataTables.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/style.css")">
    <link rel="shortcut icon" href="@Url.Content("~/Content/assets/images/favicon.png")" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* =============================================
           SPA CORE STYLES
        ============================================= */
        :root {
            --spa-primary: #1a56db;
            --spa-primary-light: #e8f0fe;
            --spa-sidebar-bg: #0f172a;
            --spa-sidebar-text: #94a3b8;
            --spa-sidebar-active: #3b82f6;
            --spa-sidebar-active-bg: rgba(59,130,246,0.12);
            --spa-header-h: 64px;
            --spa-sidebar-w: 260px;
            --spa-transition: 0.22s cubic-bezier(0.4,0,0.2,1);
            --spa-radius: 12px;
            --spa-shadow: 0 4px 24px rgba(0,0,0,0.08);
        }

        /* Reset layout để dùng SPA layout */
        .container-fluid.page-body-wrapper {
            padding: 0 !important;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ---- TOP HEADER BAR ---- */
        #spa-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--spa-header-h);
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 20px 0 0;
            z-index: 1050;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            gap: 0;
        }

        #spa-header .brand-area {
            width: var(--spa-sidebar-w);
            min-width: var(--spa-sidebar-w);
            background: var(--spa-sidebar-bg);
            height: 100%;
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 10px;
            border-right: 1px solid rgba(255,255,255,0.07);
        }

        #spa-header .brand-area .brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #3b82f6, #1a56db);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 16px; flex-shrink: 0;
        }

        #spa-header .brand-area .brand-text {
            color: #fff;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.3;
            font-family: 'Be Vietnam Pro', sans-serif;
        }

        #spa-header .brand-area .brand-text small {
            display: block;
            font-weight: 400;
            color: #94a3b8;
            font-size: 10.5px;
        }

        #spa-header .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: auto;
        }

        #spa-header .header-title {
            font-size: 14.5px;
            font-weight: 600;
            color: #1e293b;
            font-family: 'Be Vietnam Pro', sans-serif;
            margin-left: 20px;
        }

        /* ---- FILTER COMBOBOXES ---- */
        .filter-group {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 5px 12px;
        }

        .filter-group label {
            font-size: 12px;
            color: #64748b;
            font-weight: 500;
            margin: 0;
            white-space: nowrap;
        }

        .filter-select {
            border: none;
            background: transparent;
            font-size: 13px;
            font-weight: 600;
            color: var(--spa-primary);
            cursor: pointer;
            outline: none;
            font-family: 'Be Vietnam Pro', sans-serif;
            padding: 2px 4px;
            min-width: 70px;
        }

        .filter-select:focus { outline: none; }

        .btn-filter-apply {
            background: var(--spa-primary);
            color: white;
            border: none;
            border-radius: 7px;
            padding: 6px 16px;
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            transition: background var(--spa-transition);
            font-family: 'Be Vietnam Pro', sans-serif;
            display: flex; align-items: center; gap: 5px;
        }

        .btn-filter-apply:hover { background: #1e40af; }
        .btn-filter-apply i { font-size: 13px; }

        .current-period-badge {
            background: linear-gradient(135deg, #dbeafe, #e0f2fe);
            border: 1px solid #bfdbfe;
            color: #1e40af;
            border-radius: 6px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 600;
            display: flex; align-items: center; gap: 5px;
        }

        /* ---- SIDEBAR ---- */
        #spa-sidebar {
            position: fixed;
            top: var(--spa-header-h);
            left: 0;
            width: var(--spa-sidebar-w);
            height: calc(100vh - var(--spa-header-h));
            background: var(--spa-sidebar-bg);
            overflow-y: auto;
            z-index: 1040;
            padding: 16px 0 40px;
            border-right: 1px solid rgba(255,255,255,0.06);
            transition: transform var(--spa-transition);
        }

        #spa-sidebar::-webkit-scrollbar { width: 4px; }
        #spa-sidebar::-webkit-scrollbar-track { background: transparent; }
        #spa-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

        #spa-sidebar .nav-section-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #475569;
            text-transform: uppercase;
            padding: 10px 20px 6px;
        }

        #spa-sidebar .spa-nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--spa-sidebar-text);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--spa-transition);
            border-left: 3px solid transparent;
            font-family: 'Be Vietnam Pro', sans-serif;
            position: relative;
        }

        #spa-sidebar .spa-nav-link:hover {
            color: #e2e8f0;
            background: rgba(255,255,255,0.05);
            border-left-color: rgba(59,130,246,0.4);
        }

        #spa-sidebar .spa-nav-link.active {
            color: #fff;
            background: var(--spa-sidebar-active-bg);
            border-left-color: var(--spa-sidebar-active);
        }

        #spa-sidebar .spa-nav-link .nav-icon {
            width: 30px; height: 30px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 7px;
            background: rgba(255,255,255,0.06);
            font-size: 14px;
            flex-shrink: 0;
            transition: background var(--spa-transition);
        }

        #spa-sidebar .spa-nav-link.active .nav-icon,
        #spa-sidebar .spa-nav-link:hover .nav-icon {
            background: rgba(59,130,246,0.2);
            color: #93c5fd;
        }

        #spa-sidebar .nav-badge {
            margin-left: auto;
            background: rgba(59,130,246,0.2);
            color: #93c5fd;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
        }

        /* ---- MAIN CONTENT AREA ---- */
        #spa-content {
            margin-left: var(--spa-sidebar-w);
            margin-top: var(--spa-header-h);
            min-height: calc(100vh - var(--spa-header-h));
            background: #f1f5f9;
            padding: 0;
        }

        /* ---- SPA SECTIONS ---- */
        .spa-section {
            display: none;
            padding: 24px;
            animation: spaFadeIn 0.3s ease;
        }

        .spa-section.active {
            display: block;
        }

        @@keyframes spaFadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ---- PAGE HEADING ---- */
        .spa-page-heading {
            margin-bottom: 20px;
        }

        .spa-page-heading h2 {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 4px;
            font-family: 'Be Vietnam Pro', sans-serif;
        }

        .spa-page-heading p {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }

        /* ---- CARD STYLES ---- */
        .spa-card {
            background: #fff;
            border-radius: var(--spa-radius);
            box-shadow: var(--spa-shadow);
            border: 1px solid #f0f4f8;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .spa-card .card-header-custom {
            padding: 16px 20px 14px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .spa-card .card-header-custom .card-title-custom {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            font-family: 'Be Vietnam Pro', sans-serif;
            display: flex; align-items: center; gap: 8px;
        }

        .spa-card .card-header-custom .card-title-custom .title-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--spa-primary);
            flex-shrink: 0;
        }

        .spa-card .card-body-custom {
            padding: 20px;
        }

        /* ---- METRIC CARDS ---- */
        .metric-card {
            background: #fff;
            border-radius: var(--spa-radius);
            border: 1px solid #f0f4f8;
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            cursor: pointer;
            transition: all var(--spa-transition);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .metric-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--metric-color, #3b82f6), transparent);
        }

        .metric-card:hover {
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            transform: translateY(-2px);
            border-color: var(--metric-color, #3b82f6);
        }

        .metric-card .metric-label {
            font-size: 12px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-family: 'Be Vietnam Pro', sans-serif;
        }

        .metric-card .metric-value {
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            font-family: 'Be Vietnam Pro', sans-serif;
            line-height: 1.2;
        }

        .metric-card .metric-unit {
            font-size: 12px;
            color: #94a3b8;
            font-weight: 500;
        }

        .metric-card .metric-desc {
            font-size: 12px;
            color: #64748b;
            line-height: 1.5;
            margin-top: 4px;
        }

        .metric-card .metric-desc .desc-expand {
            color: var(--spa-primary);
            cursor: pointer;
            font-weight: 500;
        }

        /* Color variants for metric cards */
        .metric-card.color-blue { --metric-color: #3b82f6; }
        .metric-card.color-green { --metric-color: #10b981; }
        .metric-card.color-orange { --metric-color: #f59e0b; }
        .metric-card.color-red { --metric-color: #ef4444; }
        .metric-card.color-purple { --metric-color: #8b5cf6; }
        .metric-card.color-teal { --metric-color: #14b8a6; }
        .metric-card.color-pink { --metric-color: #ec4899; }

        /* ---- SECTION GROUP HEADERS ---- */
        .section-group-header {
            background: linear-gradient(135deg, #1e293b, #334155);
            border-radius: var(--spa-radius);
            padding: 16px 22px;
            margin-bottom: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all var(--spa-transition);
        }

        .section-group-header:hover {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

        .section-group-header.variant-primary {
            background: linear-gradient(135deg, #1a56db, #1d4ed8);
        }

        .section-group-header.variant-success {
            background: linear-gradient(135deg, #059669, #047857);
        }

        .section-group-header.variant-warning {
            background: linear-gradient(135deg, #d97706, #b45309);
        }

        .section-group-header.variant-danger {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
        }

        .section-group-header.variant-secondary {
            background: linear-gradient(135deg, #475569, #334155);
        }

        .section-group-header .group-title {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            margin: 0;
            font-family: 'Be Vietnam Pro', sans-serif;
            display: flex; align-items: center; gap: 10px;
        }

        .section-group-header .group-title i {
            font-size: 16px; opacity: 0.85;
        }

        .section-group-header .group-link-hint {
            font-size: 11.5px;
            color: rgba(255,255,255,0.65);
            display: flex; align-items: center; gap: 4px;
        }

        /* ---- CHARTS CONTAINER ---- */
        .chart-wrapper {
            position: relative;
            border-radius: 8px;
            overflow: hidden;
        }

        .chart-wrapper canvas {
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .chart-wrapper canvas:hover {
            transform: scale(1.01);
        }

        /* ---- LOADING OVERLAY ---- */
        #spa-loading {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,0.9);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            backdrop-filter: blur(4px);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
        }

        #spa-loading.show {
            opacity: 1;
            pointer-events: all;
        }

        #spa-loading .loading-spinner {
            width: 40px; height: 40px;
            border: 3px solid #e2e8f0;
            border-top-color: var(--spa-primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        #spa-loading .loading-text {
            font-size: 14px;
            color: #64748b;
            font-family: 'Be Vietnam Pro', sans-serif;
            font-weight: 500;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ---- BACK TO TOP ---- */
        #back-to-top {
            display: none;
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
            width: 44px; height: 44px;
            border-radius: 50%;
            background: var(--spa-primary);
            color: white;
            border: none;
            box-shadow: 0 4px 14px rgba(26,86,219,0.35);
            transition: all 0.3s;
            display: none;
            align-items: center; justify-content: center;
        }

        #back-to-top:hover {
            background: #1e40af;
            transform: translateY(-2px);
        }

        /* ---- RESPONSIVE ---- */
        @@media (max-width: 992px) {
            #spa-sidebar {
                transform: translateX(-100%);
            }
            #spa-sidebar.open {
                transform: translateX(0);
            }
            #spa-content {
                margin-left: 0;
            }
            #spa-header .brand-area {
                width: auto;
                min-width: auto;
            }
            .sidebar-toggle-btn {
                display: flex !important;
            }
        }

        .sidebar-toggle-btn {
            display: none;
            background: none;
            border: none;
            color: #1e293b;
            font-size: 20px;
            padding: 8px;
            cursor: pointer;
            margin-left: 12px;
        }

        /* Divider trong sidebar */
        .spa-sidebar-divider {
            height: 1px;
            background: rgba(255,255,255,0.06);
            margin: 10px 16px;
        }

        /* ---- FILTER LOADING INDICATOR ---- */
        .filter-refreshing {
            animation: pulse 1s infinite;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
    </style>
}

<!-- LOADING OVERLAY -->
<div id="spa-loading">
    <div class="loading-spinner"></div>
    <div class="loading-text">Đang tải dữ liệu...</div>
</div>

<!-- TOP HEADER -->
<div id="spa-header">
    <div class="brand-area">
        <div class="brand-icon">
            <i class="mdi mdi-chart-areaspline"></i>
        </div>
        <div class="brand-text">
            Báo cáo tổng hợp
            <small>Thuế thành phố Cần Thơ</small>
        </div>
    </div>

    <button class="sidebar-toggle-btn" id="sidebarToggleBtn" title="Menu">
        <i class="mdi mdi-menu"></i>
    </button>

    <span class="header-title d-none d-md-block">Kết quả thực hiện nhiệm vụ công tác thuế</span>

    <div class="header-right">
        <!-- Filter theo Tháng/Năm -->
        <form id="filterForm" action="@Url.Action("Dashboard", "Dashboard")" method="get" style="display:flex;align-items:center;gap:8px;">
            <div class="filter-group">
                <label>Tháng</label>
                <select class="filter-select" id="selectThang" name="thang">
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == (int)currentThang)
                        {
                            <option value="@m" selected>@m</option>
                        }
                        else
                        {
                            <option value="@m">@m</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Năm</label>
                <select class="filter-select" id="selectNam" name="nam">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        if (y == (int)currentNam)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="btn-filter-apply" id="btnApplyFilter">
                <i class="mdi mdi-refresh"></i> Lọc
            </button>
        </form>

        <div class="current-period-badge">
            <i class="mdi mdi-calendar-clock"></i>
            Tháng @currentThang / @currentNam
        </div>

        <div class="dropdown d-none d-sm-block">
            <button class="btn btn-sm btn-light" id="dropdownMenuDate2" style="font-size:12px; border-radius:8px;">
                <i class="mdi mdi-calendar"></i> <span id="todayLabel"></span>
            </button>
        </div>
    </div>
</div>

<!-- SIDEBAR -->
<nav id="spa-sidebar">
    <div class="nav-section-label">Menu chính</div>

    <a class="spa-nav-link active" data-section="section-dashboard" href="javascript:void(0)">
        <span class="nav-icon"><i class="mdi mdi-view-dashboard"></i></span>
        <span>Dashboard</span>
        <span class="nav-badge">Tổng quan</span>
    </a>

    <a class="spa-nav-link" data-section="section-bieudo" href="javascript:void(0)">
        <span class="nav-icon"><i class="mdi mdi-chart-donut"></i></span>
