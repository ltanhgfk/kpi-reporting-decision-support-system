                {
                    <div class="col-md-4 col-sm-6">
                        <div class="metric-card @colorClasses[colorIdx % colorClasses.Length]" onclick="viewChiTieuDetail('@item.MaChiTieu')">
                            <div class="metric-label">@item.MaChiTieu</div>
                            <div style="font-size:13px;font-weight:600;color:#1e293b;font-family:'Be Vietnam Pro',sans-serif;margin-bottom:6px;">@item.TenDayDu</div>
                            <div class="metric-value">@item.ThucHien.ToString("N0", nfi)</div>
                            <div class="metric-unit">@item.DonViTinh</div>
                        </div>
                    </div>
                    colorIdx++;
                }
            </div>
        </div>
    }

    <!-- ===== SECTION: HC - HÀNH CHÍNH ===== -->
    <div class="spa-section" id="section-HC">
        <div class="spa-page-heading">
            <h2>
                <i class="mdi mdi-domain" style="color:#475569;margin-right:8px;"></i>
                @{
                    var NhomChiTieuHC = NhomChiTieu?.Where(m => m.MaChiTieu == "HC").FirstOrDefault();
                    if (NhomChiTieuHC != null) { <text>@NhomChiTieuHC.TenDayDu</text> } else { <text>Hành chính - Văn phòng</text> }
                }
            </h2>
            <p>Ngày báo cáo: <strong>@NgayBCVP</strong></p>
        </div>

        <div class="section-group-header variant-secondary" onclick="viewNhomChiTieuDetail('HC')">
            <span class="group-title">
                <i class="mdi mdi-domain"></i>
                @if (NhomChiTieuHC != null) { <text>@NhomChiTieuHC.TenDayDu (@NgayBCVP)</text> } else { <text>Không tìm thấy chỉ tiêu</text> }
            </span>
            <span class="group-link-hint"><i class="mdi mdi-open-in-new"></i> Xem chi tiết</span>
        </div>

        <div class="row g-3">
            @{colorIdx = 0;}
            @foreach (var item in HC)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="metric-card @colorClasses[colorIdx % colorClasses.Length]" onclick="viewChiTieuDetail('@item.MaChiTieu')">
                        <div class="metric-label">@item.MaChiTieu</div>
                        <div style="font-size:13px;font-weight:600;color:#1e293b;font-family:'Be Vietnam Pro',sans-serif;margin-bottom:6px;">@item.TenDayDu</div>
                        <div class="metric-value">@item.ThucHien.ToString("N0", nfi)</div>
                        <div class="metric-unit">@item.DonViTinh</div>
                        <div class="metric-desc">
                            @{
                                var dg6 = item.DienGiai ?? "";
                                var hasMore6 = dg6.Length > 60;
                                var shortDg6 = hasMore6 ? dg6.Substring(0, 60) + "..." : dg6;
                            }
                            <div id="short_@item.MaChiTieu">@shortDg6
                                @if (hasMore6) { <a class="desc-expand" onclick="event.stopPropagation();showMore('@item.MaChiTieu')">Xem thêm</a> }
                            </div>
                            @if (hasMore6) {
                                <div id="full_@item.MaChiTieu" style="display:none;">@dg6 <a class="desc-expand" onclick="event.stopPropagation();showLess('@item.MaChiTieu')">Thu gọn</a></div>
                            }
                        </div>
                    </div>
                </div>
                colorIdx++;
            }
        </div>
    </div>

</div><!-- end #spa-content -->

<!-- BACK TO TOP -->
<button id="back-to-top" class="btn" title="Lên đầu trang" style="display:none;position:fixed;bottom:24px;right:24px;z-index:1000;width:44px;height:44px;border-radius:50%;background:#1a56db;color:white;border:none;box-shadow:0 4px 14px rgba(26,86,219,0.35);">
    <i class="mdi mdi-arrow-up"></i>
</button>

@section scripts {
    <script src="@Url.Content("~/Content/assets/js/jquery-3.6.0.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/chart.js@4.4.0.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/chartjs-plugin-datalabels@2.2.0.js")"></script>
    <script src="@Url.Content("~/Content/assets/vendors/js/vendor.bundle.base.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/mychart.js")"></script>
    <link href="@Url.Content("~/Content/assets/css/dataTables.bootstrap5.min.css")" rel="stylesheet" />
    <script src="@Url.Content("~/Content/assets/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/off-canvas.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/template.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/settings.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/jquery.cookie.js")" type="text/javascript"></script>

    <script>
    // ============================================================
    //  SPA NAVIGATION CORE
    // ============================================================
    function navigateTo(sectionId) {
        // Ẩn tất cả sections
        document.querySelectorAll('.spa-section').forEach(function(s) {
            s.classList.remove('active');
        });

        // Hiện section được chọn
        var target = document.getElementById(sectionId);
        if (target) {
            target.classList.add('active');
            // Cuộn lên đầu content area
            document.getElementById('spa-content').scrollTo({ top: 0, behavior: 'smooth' });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Cập nhật active nav link
        document.querySelectorAll('.spa-nav-link').forEach(function(link) {
            link.classList.remove('active');
            if (link.getAttribute('data-section') === sectionId) {
                link.classList.add('active');
            }
        });

        // Lưu vào URL hash (không reload trang)
        history.pushState(null, null, '#' + sectionId);
    }

    document.addEventListener('DOMContentLoaded', function () {

        // ---- Hiển thị ngày hôm nay ----
        var today = new Date();
        var opts = { day: '2-digit', month: 'short', year: 'numeric' };
        var todayLabel = today.toLocaleDateString('vi-VN', opts);
        var el = document.getElementById('todayLabel');
        if (el) el.innerText = todayLabel;

        // ---- Gán sự kiện click cho nav links ----
        document.querySelectorAll('.spa-nav-link[data-section]').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                var sectionId = this.getAttribute('data-section');
                navigateTo(sectionId);
            });
        });

        // ---- Xử lý hash URL khi load (nếu có) ----
        var hash = window.location.hash;
        if (hash && hash.length > 1) {
            var targetId = hash.substring(1);
            var targetEl = document.getElementById(targetId);
            if (targetEl && targetEl.classList.contains('spa-section')) {
                navigateTo(targetId);
            }
        }

        // ---- Sidebar toggle trên mobile ----
        var toggleBtn = document.getElementById('sidebarToggleBtn');
        var sidebar = document.getElementById('spa-sidebar');
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', function() {
                sidebar.classList.toggle('open');
            });
            // Đóng sidebar khi click bên ngoài
            document.addEventListener('click', function(e) {
                if (!sidebar.contains(e.target) && e.target !== toggleBtn) {
                    sidebar.classList.remove('open');
                }
            });
        }

        // ---- Back to Top ----
        var backToTop = document.getElementById('back-to-top');
        if (backToTop) {
            window.addEventListener('scroll', function () {
                backToTop.style.display = window.scrollY > 300 ? 'flex' : 'none';
            });
            backToTop.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // ---- Filter form: hiện loading khi submit ----
        var filterForm = document.getElementById('filterForm');
        if (filterForm) {
            filterForm.addEventListener('submit', function() {
                var loading = document.getElementById('spa-loading');
                if (loading) loading.classList.add('show');
            });
        }
    });

    // ============================================================
    //  UTILITY FUNCTIONS
    // ============================================================
    function showMore(maChiTieu) {
        var s = document.getElementById('short_' + maChiTieu);
        var f = document.getElementById('full_' + maChiTieu);
        if (s) s.style.display = 'none';
        if (f) f.style.display = 'block';
    }

    function showLess(maChiTieu) {
        var s = document.getElementById('short_' + maChiTieu);
        var f = document.getElementById('full_' + maChiTieu);
        if (f) f.style.display = 'none';
        if (s) s.style.display = 'block';
    }

    function showDiaBanDetail() {
        window.open('@Url.Action("DetailDiaBan", "Dashboard")', '_blank');
    }

    function showChiTieuDetail() {
        window.open('@Url.Action("DetailChiTieu", "Dashboard")', '_blank');
    }

    function viewChiTieuDetail(maChiTieu) {
        if (maChiTieu && maChiTieu.trim() !== '') {
            window.open('@Url.Action("ChiTieuDetail", "Dashboard")?maChiTieu=' + encodeURIComponent(maChiTieu), '_blank');
        }
    }

    function viewChiTieuDetailDT(maChiTieu) {
        if (maChiTieu && maChiTieu.trim() !== '') {
            window.open('@Url.Action("ChiTieuDetailDT", "Dashboard")?maChiTieu=' + encodeURIComponent(maChiTieu), '_blank');
        }
    }

    function viewNhomChiTieuDetail(nhomChiTieu) {
        if (nhomChiTieu && nhomChiTieu.trim() !== '') {
            window.open('@Url.Action("NhomChiTieuDetail", "Dashboard")?nhomChiTieu=' + encodeURIComponent(nhomChiTieu), '_blank');
        }
    }
    </script>
}
