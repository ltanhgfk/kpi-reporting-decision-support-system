    <div class="empty-state mb-3">
      <i class="mdi mdi-database-off-outline"></i>
      <p>Không có dữ liệu thu ngân sách cho <strong>Tháng @currentThang / @currentNam</strong></p>
    </div>
  }

  @* ── CHARTS ROW ── *@
  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="sc2" style="height:100%">
        <div class="sc2-h">
          <span class="sc2-t"><span class="sc2-dot" style="background:#3b82f6"></span>Thu nội địa (@(string.IsNullOrEmpty(NgayBaoCaoDT) ? "Chưa có dữ liệu" : NgayBaoCaoDT))</span>
          @if(TongThuNoiDia!=null){<a class="sc2-a" href="javascript:void(0)" onclick="goDT('@TongThuNoiDia.MaChiTieu')"><i class="mdi mdi-open-in-new"></i></a>}
        </div>
        <div class="sc2-b">
          @if(TongThuNoiDia!=null && (TongThuNoiDia.ThucHien>0||TongThuNoiDia.KeHoach>0)){
            <div class="cw" onclick="goDT('@TongThuNoiDia.MaChiTieu')"><canvas id="c_ttnd"></canvas></div>
          } else {
            <div class="empty-state"><i class="mdi mdi-chart-pie-outline"></i><p>Không có dữ liệu Tháng @currentThang / @currentNam</p></div>
          }
        </div>
      </div>
    </div>
    <div class="col-md-8">
      <div class="sc2" style="height:100%">
        <div class="sc2-h">
          <span class="sc2-t"><span class="sc2-dot" style="background:#10b981"></span>Thu theo địa bàn</span>
          @if(DonViAll.Any()){<a class="sc2-a" href="javascript:void(0)" onclick="goDiaBan()">Chi tiết <i class="mdi mdi-open-in-new"></i></a>}
        </div>
        <div class="sc2-b">
          @if(DonViAll.Any()){
            <div class="cw" onclick="goDiaBan()"><canvas id="c_db"></canvas></div>
          } else {
            <div class="empty-state"><i class="mdi mdi-chart-line"></i><p>Không có dữ liệu theo địa bàn Tháng @currentThang / @currentNam</p></div>
          }
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-8">
      <div class="sc2" style="height:100%">
        <div class="sc2-h">
          <span class="sc2-t"><span class="sc2-dot" style="background:#f59e0b"></span>Nguồn thu, sắc thuế</span>
          @if(ChiTieuAll.Any()){<a class="sc2-a" href="javascript:void(0)" onclick="goCT()">Chi tiết <i class="mdi mdi-open-in-new"></i></a>}
        </div>
        <div class="sc2-b">
          @if(ChiTieuAll.Any()){
            <div class="cw" onclick="goCT()"><canvas id="c_ct"></canvas></div>
          } else {
            <div class="empty-state"><i class="mdi mdi-chart-bar"></i><p>Không có dữ liệu nguồn thu Tháng @currentThang / @currentNam</p></div>
          }
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="sc2" style="height:100%">
        <div class="sc2-h">
          <span class="sc2-t"><span class="sc2-dot" style="background:#8b5cf6"></span>Thu trừ 3 khoản</span>
          @if(TTRU!=null){<a class="sc2-a" href="javascript:void(0)" onclick="goDT('@TTRU.MaChiTieu')"><i class="mdi mdi-open-in-new"></i></a>}
        </div>
        <div class="sc2-b">
          @if(TTRU!=null && (TTRU.ThucHien>0||TTRU.KeHoach>0)){
            <div class="cw" onclick="goDT('@TTRU.MaChiTieu')"><canvas id="c_ttru"></canvas></div>
          } else {
            <div class="empty-state"><i class="mdi mdi-chart-pie-outline"></i><p>Không có dữ liệu Tháng @currentThang / @currentNam</p></div>
          }
        </div>
      </div>
    </div>
  </div>

  @* ── QUICK NAV ── *@
  <div class="sc2">
    <div class="sc2-h"><span class="sc2-t"><span class="sc2-dot" style="background:#64748b"></span>Chỉ tiêu chuyên môn</span></div>
    <div class="sc2-b">
      <div class="row g-3">
        @foreach(var n in NhomChiTieu){
          var data2 = getNhomData(n.MaChiTieu);
          var ico3 = nhomIcon.ContainsKey(n.MaChiTieu) ? nhomIcon[n.MaChiTieu] : "mdi-chart-box";
          var grd3 = nhomGrd.ContainsKey(n.MaChiTieu) ? nhomGrd[n.MaChiTieu] : "135deg,#3b82f6,#2563eb";
          <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="qnc" onclick="go('s-@n.MaChiTieu')">
              <div class="qnc-ico" style="background:linear-gradient(@grd3)">
                <i class="mdi @ico3" style="color:#fff"></i>
              </div>
              <div>
                <div class="qnc-lbl">@n.MaChiTieu · @data2.Count chỉ tiêu</div>
                <div class="qnc-nm">@n.TenChiTieu</div>
                <div class="qnc-arr">Xem chi tiết →</div>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</div><!-- /s0 -->

<!-- ════════ SECTION MACRO: render từng nhóm chỉ tiêu ════════ -->
@{
    var nhomDataMap = new Dictionary<string, (List<BaoCaoViewModel> data, string ngay, string secId)> {
        {"DN", (DN, NgayBCQLDN, "s-DN")},
        {"HT", (HT, NgayBCQLDN, "s-HT")},
        {"KT", (KT, NgayBCKT,   "s-KT")},
        {"NO", (NO, NgayBCQLDN, "s-NO")},
        {"HD", (HD, NgayBCKT,   "s-HD")},
        {"CN", (CN, NgayBCCNTK, "s-CN")},
        {"HC", (HC, NgayBCVP,   "s-HC")},
    };

    foreach(var ma in new[]{"DN","HT","KT","NO","HD","CN","HC"}){
        var nct2 = NhomChiTieu.FirstOrDefault(x => x.MaChiTieu == ma);
        if(nct2 != null){
        var ico4 = nhomIcon.ContainsKey(ma) ? nhomIcon[ma] : "mdi-chart-box";
        var grd4 = nhomGrd.ContainsKey(ma)  ? nhomGrd[ma]  : "135deg,#3b82f6,#2563eb";
        var (dataList, ngayBC, secId4) = nhomDataMap[ma];
        
        <div class="sec" id="s-@ma">
          <div class="ph">
            <h2>
              <i class="mdi @ico4" style="color:var(--pri)"></i>
              @(nct2.TenDayDu ?? nct2.TenChiTieu)
            </h2>
            <p>Tháng <strong>@currentThang / @currentNam</strong> &nbsp;·&nbsp; Ngày BC: <strong>@ngayBC</strong></p>
          </div>

          <div class="gh" style="background:linear-gradient(@grd4)" onclick="viewNhom('@ma')">
            <span class="gh-t"><i class="mdi @ico4"></i> @(nct2.TenDayDu ?? nct2.TenChiTieu) (@ngayBC)</span>
            <span class="gh-h"><i class="mdi mdi-open-in-new"></i> Xem chi tiết</span>
          </div>

          @if(!dataList.Any()){
            <div class="empty-state">
              <i class="mdi mdi-database-off-outline"></i>
              <p>Không có dữ liệu <strong>@(nct2.TenChiTieu)</strong> cho <strong>Tháng @currentThang / @currentNam</strong></p>
            </div>
          } else {
            <div class="row g-3">
              @{ int ci2 = 0; }
              @foreach(var item in dataList){
                var cc2 = cardPalette[ci2 % cardPalette.Length];
                var dg2 = item.DienGiai ?? "";
                var hm2 = dg2.Length > 55;
                var sdg2 = hm2 ? dg2.Substring(0,55)+"…" : dg2;
                var pct3 = item.KeHoach > 0 ? Math.Round(item.ThucHien/item.KeHoach*100,1) : 0d;
                string pcc(double v) => v>=90?"g":v>=70?"w":"b";
                <div class="col-sm-6 col-md-4">
                  <div class="kc" style="--cc:@cc2" onclick="goCTD('@item.MaChiTieu')">
                    <div class="kc-lbl">@item.MaChiTieu</div>
                    <div style="font-size:12.5px;font-weight:700;color:#1e293b;line-height:1.35;margin-bottom:4px;font-family:'Be Vietnam Pro',sans-serif">@item.TenDayDu</div>
                    <div class="kc-val">@item.ThucHien.ToString("N0",nfi)</div>
                    <div class="kc-dvt">@item.DonViTinh</div>
                    @if(item.KeHoach > 0){
                      <span class="kc-pct @pcc(pct3)"><i class="mdi mdi-trending-up"></i> @pct3% KH</span>
                    }
                    @if(!string.IsNullOrWhiteSpace(dg2)){
                      <div class="kc-desc">
                        <span id="sd_@item.MaChiTieu">@sdg2
                          @if(hm2){<a class="kc-more" onclick="event.stopPropagation();sm('@item.MaChiTieu',1)">Xem thêm</a>}
                        </span>
                        @if(hm2){<span id="fd_@item.MaChiTieu" style="display:none">@dg2 <a class="kc-more" onclick="event.stopPropagation();sm('@item.MaChiTieu',0)">Thu gọn</a></span>}
                      </div>
                    }
                  </div>
                </div>
                ci2++;
              }
            </div>
          }
        </div><!-- /s-@ma -->
        } @* end if(nct2 != null) *@
    }
}

</div><!-- /C -->

<button id="btt" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="mdi mdi-arrow-up"></i></button>

