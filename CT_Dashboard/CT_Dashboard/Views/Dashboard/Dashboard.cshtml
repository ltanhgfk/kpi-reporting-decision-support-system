<script src="@Url.Content("~/Content/assets/js/mychart.js")"></script>
<script src="@Url.Content("~/Content/assets/js/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/Content/assets/js/dataTables.bootstrap5.min.js")"></script>
<script src="@Url.Content("~/Content/assets/js/off-canvas.js")"></script>
<script src="@Url.Content("~/Content/assets/js/template.js")"></script>
<script src="@Url.Content("~/Content/assets/js/settings.js")"></script>
<script src="@Url.Content("~/Content/assets/js/jquery.cookie.js")"></script>

<script>
// ── DỮ LIỆU CHART từ server ──────────────────────────────────
var CD = {
  ttnd:  { lb:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(lbTTND)),  val:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(valTTND)),  ttl:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((TongThuNoiDia?.TenChiTieu ?? "")+" ("+NgayBaoCaoDT+")")) },
  ttru:  { lb:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(lbTTRU)),  val:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(valTTRU)),  ttl:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((TTRU?.TenChiTieu ?? "")+" ("+NgayBaoCaoDT+")")) },
  db:    { lb:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(lbDV)),    th:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(thDV)),    kh:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(khDV)),    ck:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ckDV)),    ttl:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject("Thu ngân sách theo địa bàn ("+NgayBaoCaoDT+")")) },
  ct:    { lb:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(lbCT)),    th:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(thCT)),    kh:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(khCT)),    ck:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ckCT)),    ttl:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject("Nguồn thu, sắc thuế ("+NgayBaoCaoDT+")")) }
};

// ── RENDER CHARTS ─────────────────────────────────────────────
function renderCharts(){
  if(document.getElementById('c_ttnd') && CD.ttnd.val[0]+CD.ttnd.val[1]>0)
    renderDonutChart(CD.ttnd.lb, CD.ttnd.val, 'c_ttnd', CD.ttnd.ttl, ['#36A2EB','#FF6384']);

  if(document.getElementById('c_ttru') && CD.ttru.val[0]+CD.ttru.val[1]>0)
    renderDonutChart(CD.ttru.lb, CD.ttru.val, 'c_ttru', CD.ttru.ttl, ['#36A2EB','#ff4747']);

  if(document.getElementById('c_db') && CD.db.lb.length>0)
    renderLineChart('c_db', CD.db.lb, CD.db.th, CD.db.kh, CD.db.ck, CD.db.ttl, 'Địa bàn', 'Số thu');

  if(document.getElementById('c_ct') && CD.ct.lb.length>0)
    renderBarChart('c_ct', CD.ct.lb, CD.ct.th, CD.ct.kh, CD.ct.ck, CD.ct.ttl, 'Nguồn thu', 'Số thu', ['#36A2EB','#FF6384']);
}

// ── SPA NAVIGATION ────────────────────────────────────────────
function go(id){
  document.querySelectorAll('.sec').forEach(function(e){ e.classList.remove('on'); });
  var el = document.getElementById(id);
  if(el) el.classList.add('on');
  document.querySelectorAll('.nl[data-s]').forEach(function(a){
    a.classList.toggle('active', a.getAttribute('data-s')===id);
  });
  window.scrollTo({top:0,behavior:'smooth'});
  history.replaceState(null,'','#'+id);
  if(window.innerWidth<992) closeSB();
}

// ── SIDEBAR TOGGLE ────────────────────────────────────────────
function closeSB(){
  document.getElementById('S').classList.remove('mo');
  document.getElementById('backdrop').classList.remove('show');
}

document.getElementById('toggleBtn').addEventListener('click',function(){
  if(window.innerWidth<992){
    document.getElementById('S').classList.toggle('mo');
    document.getElementById('backdrop').classList.toggle('show');
  } else {
    document.body.classList.toggle('sc');
  }
});
document.getElementById('backdrop').addEventListener('click', closeSB);
window.addEventListener('resize',function(){
  if(window.innerWidth>=992) closeSB();
});

// ── INIT ──────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded',function(){
  // Nav links
  document.querySelectorAll('.nl[data-s]').forEach(function(a){
    a.addEventListener('click',function(e){ e.preventDefault(); go(this.getAttribute('data-s')); });
  });

  // Hash restore
  var h = window.location.hash;
  if(h && h.length>1 && document.getElementById(h.substring(1)))
    go(h.substring(1));

  // Render charts SAU KHI tất cả scripts đã load
  renderCharts();

  // Filter loading
  document.getElementById('ff').addEventListener('submit',function(){
    document.getElementById('ld').classList.add('on');
  });

  // Back to top
  var btt = document.getElementById('btt');
  window.addEventListener('scroll',function(){ btt.style.display = window.scrollY>300?'flex':'none'; });
});

// ── UTILITIES ─────────────────────────────────────────────────
function sm(id, show){
  var s=document.getElementById('sd_'+id), f=document.getElementById('fd_'+id);
  if(!s||!f) return;
  s.style.display=show?'none':'inline'; f.style.display=show?'inline':'none';
}
function goDiaBan(){ window.open('@Url.Action("DetailDiaBan","Dashboard")','_blank'); }
function goCT()    { window.open('@Url.Action("DetailChiTieu","Dashboard")','_blank'); }
function goCTD(ma) { if(ma) window.open('@Url.Action("ChiTieuDetail","Dashboard")?maChiTieu='+encodeURIComponent(ma),'_blank'); }
function goDT(ma)  { if(ma) window.open('@Url.Action("ChiTieuDetailDT","Dashboard")?maChiTieu='+encodeURIComponent(ma),'_blank'); }
function viewNhom(n){ if(n) window.open('@Url.Action("NhomChiTieuDetail","Dashboard")?nhomChiTieu='+encodeURIComponent(n),'_blank'); }
</script>
}
