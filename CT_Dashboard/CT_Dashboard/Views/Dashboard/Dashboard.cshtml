@using System.Linq
@using System.Globalization
@using CT_Dashboard.Models

@{
    ViewBag.Title = "Báo cáo kết quả thực hiện nhiệm vụ, công tác thuế";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var NhomChiTieu  = ViewBag.NhomChiTieu as List<ChiTieuViewModel> ?? new List<ChiTieuViewModel>();
    var TongThuNoiDia = ViewBag.TTND as BaoCaoViewModel;
    var TTRU          = ViewBag.TTRU as BaoCaoViewModel;
    var ChiTieuAll    = ViewBag.ChiTieuAll as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var DonViAll      = ViewBag.DonViAll   as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var DN = ViewBag.DN as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var HT = ViewBag.HT as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var KT = ViewBag.KT as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var NO = ViewBag.NO as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var HD = ViewBag.HD as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var CN = ViewBag.CN as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();
    var HC = ViewBag.HC as List<BaoCaoViewModel> ?? new List<BaoCaoViewModel>();

    var NgayBCQLDN = (string)ViewBag.NgayBCQLDN ?? "Chưa có dữ liệu";
    var NgayBCKT   = (string)ViewBag.NgayBCKT   ?? "Chưa có dữ liệu";
    var NgayBCCNTK = (string)ViewBag.NgayBCCNTK ?? "Chưa có dữ liệu";
    var NgayBCVP   = (string)ViewBag.NgayBCVP   ?? "Chưa có dữ liệu";

    int currentThang = (int)(ViewBag.CurrentThang ?? DateTime.Now.Month);
    int currentNam   = (int)(ViewBag.CurrentNam   ?? DateTime.Now.Year);

    var NgayBaoCaoDT = TongThuNoiDia?.NgaySoLieu != null && TongThuNoiDia.NgaySoLieu != DateTime.MinValue ? TongThuNoiDia.NgaySoLieu?.ToString("dd/MM/yyyy") : "";

    //var NgayBaoCaoDT = TongThuNoiDia?.NgaySoLieu?.ToString("dd/MM/yyyy") ?? "";

    var nfi          = new CultureInfo("vi-VN").NumberFormat;

    // Chart data arrays
    var lbTTND    = new[] { "Thực hiện", "Còn lại" };
    var valTTND   = TongThuNoiDia != null ? new[] { TongThuNoiDia.ThucHien, Math.Max(TongThuNoiDia.Conlai, 0) } : new[] { 0d, 0d };
    var lbTTRU    = new[] { "Thực hiện", "Còn lại" };
    var valTTRU   = TTRU != null ? new[] { TTRU.ThucHien, Math.Max(TTRU.Conlai, 0) } : new[] { 0d, 0d };
    var lbCT      = ChiTieuAll.Select(x => x.TenChiTieu).ToArray();
    var thCT      = ChiTieuAll.Select(x => x.ThucHien).ToArray();
    var khCT      = ChiTieuAll.Select(x => x.KeHoach).ToArray();
    var ckCT      = ChiTieuAll.Select(x => x.CungKy).ToArray();
    var lbDV      = DonViAll.Select(x => x.MaDiaBan).ToArray();
    var thDV      = DonViAll.Select(x => x.ThucHien).ToArray();
    var khDV      = DonViAll.Select(x => x.KeHoach).ToArray();
    var ckDV      = DonViAll.Select(x => x.CungKy).ToArray();

    // nhóm meta
    var nhomIcon = new Dictionary<string,string> {
        {"DN","mdi-office-building"}, {"HT","mdi-handshake"}, {"KT","mdi-gavel"},
        {"NO","mdi-cash-clock"}, {"HD","mdi-file-document-multiple"},
        {"CN","mdi-cog-outline"}, {"HC","mdi-domain"}
    };
    var nhomGrd = new Dictionary<string,string> {
        {"DN","135deg,#1a56db,#2563eb"}, {"HT","135deg,#0d9488,#0891b2"},
        {"KT","135deg,#d97706,#b45309"}, {"NO","135deg,#059669,#047857"},
        {"HD","135deg,#7c3aed,#6d28d9"}, {"CN","135deg,#0369a1,#0284c7"},
        {"HC","135deg,#475569,#334155"}
    };
    var cardPalette = new[] {"#3b82f6","#10b981","#f59e0b","#ef4444","#8b5cf6","#14b8a6","#ec4899","#f97316"};

    Func<string, List<BaoCaoViewModel>> getNhomData = (ma) => {
        if (ma == "DN") return DN; if (ma == "HT") return HT; if (ma == "KT") return KT;
        if (ma == "NO") return NO; if (ma == "HD") return HD; if (ma == "CN") return CN;
        if (ma == "HC") return HC; return new List<BaoCaoViewModel>();
    };
}

@section styles {
<link rel="stylesheet" href="@Url.Content("~/Content/assets/css/bootstrap.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/feather/feather.css")">
<link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/css/vendor.bundle.base.css")">
<link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/font-awesome/css/font-awesome.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Content/assets/vendors/mdi/css/materialdesignicons.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Content/assets/css/dataTables.bootstrap5.min.css")">
<link rel="stylesheet" href="@Url.Content("~/Content/assets/css/style.css")">
<link rel="shortcut icon" href="@Url.Content("~/Content/assets/images/favicon.png")" />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ─── RESET TEMPLATE ──────────────────────────── */
body { overflow-x: hidden; background: #f1f5f9 !important; }
.sidebar.sidebar-offcanvas   { display: none !important; }
.navbar.default-layout-navbar { display: none !important; }
.container-fluid.page-body-wrapper { padding: 0 !important; margin: 0 !important; }
.main-panel  { margin: 0 !important; width: 100% !important; min-height: 100vh; }
.content-wrapper { padding: 0 !important; background: #f1f5f9 !important; }

/* ─── VARIABLES ───────────────────────────────── */
:root {
  --hh: 62px;
  --sw: 252px;
  --pri: #1a56db;
  --sbg: #0f172a;
  --tr:  .2s ease;
  --r:   12px;
}

/* ─── HEADER ──────────────────────────────────── */
#H {
  position: fixed; top: 0; left: 0; right: 0; height: var(--hh);
  background: #fff; border-bottom: 1px solid #e2e8f0;
  display: flex; align-items: center; z-index: 1060;
  box-shadow: 0 1px 6px rgba(0,0,0,.08);
}
.h-brand {
  width: var(--sw); min-width: var(--sw); height: 100%;
  background: var(--sbg); display: flex; align-items: center; gap: 10px;
  padding: 0 16px; transition: width var(--tr), min-width var(--tr);
  overflow: hidden;
}
.h-brand-icon {
  width: 34px; height: 34px; border-radius: 8px; background: var(--pri);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 17px; flex-shrink: 0;
}
.h-brand-txt  { color: #fff; font-size: 12.5px; font-weight: 700; white-space: nowrap; line-height: 1.3; }
.h-brand-txt small { display: block; font-weight: 400; color: #94a3b8; font-size: 10.5px; }
#toggleBtn {
  background: none; border: none; cursor: pointer;
  width: 40px; height: 40px; border-radius: 8px; margin-left: 8px;
  color: #475569; font-size: 22px; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: background var(--tr);
}
#toggleBtn:hover { background: #f1f5f9; }
.h-right { display: flex; align-items: center; gap: 8px; margin-left: auto; padding-right: 16px; }
.fp { display: flex; align-items: center; gap: 5px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 4px 10px; }
.fp label { font-size: 11px; font-weight: 600; color: #64748b; margin: 0; white-space: nowrap; }
.fp select { border: none; background: transparent; font-size: 13px; font-weight: 700; color: var(--pri); cursor: pointer; outline: none; font-family: 'Be Vietnam Pro', sans-serif; padding: 1px 2px; }
.btn-lc {
  background: var(--pri); color: #fff; border: none; border-radius: 7px;
  padding: 6px 14px; font-size: 12.5px; font-weight: 600; cursor: pointer;
  display: flex; align-items: center; gap: 4px; white-space: nowrap;
  font-family: 'Be Vietnam Pro', sans-serif; transition: background var(--tr);
}
.btn-lc:hover { background: #1e40af; }
.kybadge {
  background: #dbeafe; color: #1e40af; border-radius: 6px;
  padding: 5px 11px; font-size: 12px; font-weight: 700;
  display: flex; align-items: center; gap: 5px; white-space: nowrap;
}

/* ─── SIDEBAR ─────────────────────────────────── */
#S {
  position: fixed; top: var(--hh); left: 0;
  width: var(--sw); height: calc(100vh - var(--hh));
  background: var(--sbg); overflow-y: auto; overflow-x: hidden;
  z-index: 1050; border-right: 1px solid rgba(255,255,255,.05);
  transition: transform var(--tr), width var(--tr);
}
#S::-webkit-scrollbar { width: 3px; }
#S::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 2px; }
.ns-lbl { font-size: 9.5px; font-weight: 800; letter-spacing: 1.3px; color: #475569; text-transform: uppercase; padding: 14px 18px 4px; }
.ns-div { height: 1px; background: rgba(255,255,255,.06); margin: 8px 14px; }
.nl {
  display: flex; align-items: center; gap: 9px;
  padding: 9px 16px; cursor: pointer; text-decoration: none;
  color: #94a3b8; font-size: 13px; font-weight: 500;
  border-left: 3px solid transparent; transition: all var(--tr);
  font-family: 'Be Vietnam Pro', sans-serif; white-space: nowrap; overflow: hidden;
}
.nl:hover { color: #e2e8f0; background: rgba(255,255,255,.04); border-left-color: rgba(59,130,246,.4); text-decoration: none; }
.nl.active { color: #fff; background: rgba(59,130,246,.13); border-left-color: #3b82f6; }
.nl .ni { width: 28px; height: 28px; border-radius: 6px; background: rgba(255,255,255,.05); display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; transition: background var(--tr); }
.nl.active .ni, .nl:hover .ni { background: rgba(59,130,246,.2); color: #93c5fd; }
.nl .nt { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.nl .nb { font-size: 9.5px; font-weight: 700; background: rgba(59,130,246,.2); color: #93c5fd; border-radius: 4px; padding: 1px 5px; flex-shrink: 0; }

/* ─── SIDEBAR COLLAPSED (desktop) ─────────────── */
body.sc #S          { width: 54px; }
body.sc .h-brand    { width: 54px; min-width: 54px; }
body.sc .h-brand-txt { display: none; }
body.sc .nt, body.sc .nb, body.sc .ns-lbl, body.sc .ns-div { display: none; }
body.sc .nl         { padding: 9px 13px; justify-content: center; }
body.sc #C          { margin-left: 54px; }

/* ─── MOBILE ──────────────────────────────────── */
@@media (max-width: 991px) {
  #S { transform: translateX(-100%); width: var(--sw) !important; box-shadow: 4px 0 20px rgba(0,0,0,.3); }
  #S.mo { transform: translateX(0); }
  #C { margin-left: 0 !important; }
  .h-brand { width: auto !important; min-width: 0 !important; }
  .h-brand-txt { display: none !important; }
  body.sc #S { width: var(--sw) !important; }
  body.sc #C { margin-left: 0 !important; }
  .fp, .btn-lc { display: none !important; }
}
@@media (max-width: 575px) {
  .kybadge { font-size: 11px; padding: 4px 8px; }
}
#backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 1049; }
#backdrop.show { display: block; }

/* ─── CONTENT ─────────────────────────────────── */
#C {
  margin-left: var(--sw); margin-top: var(--hh);
  min-height: calc(100vh - var(--hh)); background: #f1f5f9;
  transition: margin-left var(--tr);
}

/* ─── SECTIONS ────────────────────────────────── */
.sec { display: none; padding: 22px 20px 40px; }
.sec.on { display: block; animation: fu .25s ease; }
@@keyframes fu { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

/* ─── PAGE HEADING ────────────────────────────── */
.ph { margin-bottom: 18px; }
.ph h2 { font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 3px; font-family: 'Be Vietnam Pro', sans-serif; display: flex; align-items: center; gap: 8px; }
.ph p  { font-size: 12.5px; color: #64748b; margin: 0; }
.ph strong { color: #1e293b; }

/* ─── CARDS ───────────────────────────────────── */
.sc2 { background: #fff; border-radius: var(--r); border: 1px solid #e8edf3; box-shadow: 0 2px 8px rgba(0,0,0,.05); margin-bottom: 18px; overflow: hidden; }
.sc2-h { padding: 13px 18px 11px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.sc2-t { font-size: 13.5px; font-weight: 700; color: #1e293b; margin: 0; display: flex; align-items: center; gap: 7px; font-family: 'Be Vietnam Pro', sans-serif; }
.sc2-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.sc2-b { padding: 18px; }
.sc2-a { font-size: 12px; font-weight: 600; color: var(--pri); text-decoration: none; white-space: nowrap; }
.sc2-a:hover { text-decoration: underline; }

/* ─── KPI STAT CARDS ──────────────────────────── */
.kc {
  background: #fff; border-radius: var(--r); border: 1px solid #e8edf3;
  padding: 16px 18px; display: flex; flex-direction: column; gap: 5px;
  cursor: pointer; transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
  position: relative; overflow: hidden; height: 100%;
}
.kc::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--cc, var(--pri)); }
.kc:hover   { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1); border-color: var(--cc, var(--pri)); }
.kc-ico { width: 36px; height: 36px; border-radius: 9px; background: color-mix(in srgb,var(--cc,var(--pri)) 12%,#fff); display: flex; align-items: center; justify-content: center; font-size: 17px; color: var(--cc,var(--pri)); flex-shrink: 0; margin-bottom: 2px; }
.kc-lbl { font-size: 10.5px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .5px; }
.kc-val { font-size: 21px; font-weight: 800; color: #0f172a; font-family: 'Be Vietnam Pro', sans-serif; line-height: 1.2; }
.kc-dvt { font-size: 11.5px; color: #94a3b8; }
.kc-pct { font-size: 11.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 5px; margin-top: 1px; }
.kc-pct.g { background: #dcfce7; color: #16a34a; }
.kc-pct.w { background: #fef3c7; color: #d97706; }
.kc-pct.b { background: #fee2e2; color: #dc2626; }
.kc-desc { font-size: 11.5px; color: #64748b; line-height: 1.45; margin-top: 2px; }
.kc-more { color: var(--pri); cursor: pointer; font-weight: 600; }

/* ─── GROUP HEADER ────────────────────────────── */
.gh {
  border-radius: var(--r); padding: 13px 18px; margin-bottom: 14px;
  cursor: pointer; display: flex; align-items: center; justify-content: space-between;
  transition: opacity var(--tr);
}
.gh:hover { opacity: .9; }
.gh-t { font-size: 13.5px; font-weight: 700; color: #fff; margin: 0; display: flex; align-items: center; gap: 9px; }
.gh-h { font-size: 11.5px; color: rgba(255,255,255,.65); display: flex; align-items: center; gap: 3px; white-space: nowrap; }

/* ─── EMPTY STATE ─────────────────────────────── */
.empty-state {
  padding: 48px 24px; text-align: center; background: #fff;
  border-radius: var(--r); border: 2px dashed #e2e8f0;
}
.empty-state i { font-size: 40px; color: #cbd5e1; display: block; margin-bottom: 12px; }
.empty-state p { color: #64748b; font-size: 14px; margin: 0; }

/* ─── QUICK NAV ───────────────────────────────── */
.qnc {
  background: #fff; border-radius: var(--r); border: 1px solid #e8edf3;
  padding: 13px 15px; cursor: pointer; transition: all var(--tr);
  display: flex; align-items: center; gap: 12px;
}
.qnc:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); border-color: #3b82f6; }
.qnc-ico { width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 18px; }
.qnc-lbl { font-size: 10.5px; color: #94a3b8; font-weight: 600; text-transform: uppercase; }
.qnc-nm  { font-size: 13px; font-weight: 700; color: #1e293b; font-family: 'Be Vietnam Pro', sans-serif; line-height: 1.3; }
.qnc-arr { font-size: 11px; color: var(--pri); font-weight: 600; margin-top: 1px; }

/* ─── CHART ───────────────────────────────────── */
.cw { position: relative; cursor: pointer; }
.cw canvas { transition: transform .2s ease; }
.cw:hover canvas { transform: scale(1.01); }

/* ─── MISC ────────────────────────────────────── */
#btt { display: none; position: fixed; bottom: 22px; right: 22px; z-index: 1000; width: 42px; height: 42px; border-radius: 50%; background: var(--pri); color: #fff; border: none; box-shadow: 0 4px 14px rgba(26,86,219,.35); align-items: center; justify-content: center; font-size: 18px; cursor: pointer; transition: all var(--tr); }
#btt:hover { background: #1e40af; transform: translateY(-2px); }
#ld { display: none; position: fixed; inset: 0; background: rgba(255,255,255,.88); z-index: 9999; align-items: center; justify-content: center; flex-direction: column; gap: 12px; backdrop-filter: blur(3px); }
#ld.on { display: flex; }
.ld-s { width: 38px; height: 38px; border: 3px solid #e2e8f0; border-top-color: var(--pri); border-radius: 50%; animation: sp .75s linear infinite; }
.ld-t { font-size: 13.5px; color: #475569; font-family: 'Be Vietnam Pro', sans-serif; font-weight: 600; }
@@keyframes sp { to { transform: rotate(360deg); } }

@@media (max-width: 767px) {
  .sec { padding: 14px 12px 30px; }
  .sc2-b { padding: 12px; }
  .kc-val { font-size: 17px; }
}
</style>
}

<div id="ld"><div class="ld-s"></div><div class="ld-t">Đang tải dữ liệu...</div></div>
<div id="backdrop"></div>

<!-- ═══════════════════════════════════════════════════ HEADER -->
<div id="H">
  <div class="h-brand">
    <div class="h-brand-icon"><i class="mdi mdi-chart-areaspline"></i></div>
    <div class="h-brand-txt">CT Dashboard<small>Cục Thuế Cần Thơ</small></div>
  </div>

  <button id="toggleBtn" title="Thu/mở menu"><i class="mdi mdi-menu"></i></button>

  <div class="h-right">
    <form id="ff" action="@Url.Action("Dashboard","Dashboard")" method="get"
          style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <div class="fp">
        <label>Tháng</label>
        <select name="thang" id="selT">
          @for(int m=1;m<=12;m++){<option value="@m" @(m==currentThang?"selected":"")>@m</option>}
        </select>
      </div>
      <div class="fp">
        <label>Năm</label>
        <select name="nam" id="selN">
          @for(int y=DateTime.Now.Year;y>=DateTime.Now.Year-5;y--){<option value="@y" @(y==currentNam?"selected":"")>@y</option>}
        </select>
      </div>
      <button type="submit" class="btn-lc" id="btnLoc">
        <i class="mdi mdi-refresh"></i> Lọc
      </button>
    </form>
    <div class="kybadge"><i class="mdi mdi-calendar-month"></i> @currentThang / @currentNam</div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════ SIDEBAR -->
<nav id="S">
  <div class="ns-lbl">Tổng quan</div>
  <a class="nl active" data-s="s0" href="javascript:void(0)">
    <span class="ni"><i class="mdi mdi-view-dashboard-outline"></i></span>
    <span class="nt">Dashboard</span>
    <span class="nb">Home</span>
  </a>
  <div class="ns-div"></div>
  <div class="ns-lbl">Chỉ tiêu chuyên môn</div>
  @foreach(var n in NhomChiTieu){
    var ico2 = nhomIcon.ContainsKey(n.MaChiTieu) ? nhomIcon[n.MaChiTieu] : "mdi-chart-box";
    <a class="nl" data-s="s-@n.MaChiTieu" href="javascript:void(0)">
      <span class="ni"><i class="mdi @ico2"></i></span>
      <span class="nt">@n.TenChiTieu</span>
    </a>
  }
</nav>

<!-- ═══════════════════════════════════════════════════ CONTENT -->
<div id="C">

<!-- ════════ SECTION: DASHBOARD ════════ -->
<div class="sec on" id="s0">
  <div class="ph">
    <h2><i class="mdi mdi-view-dashboard-outline" style="color:var(--pri)"></i>Dashboard – Tổng quan</h2>
    <p>Dữ liệu <strong>Tháng @currentThang / @currentNam</strong> &nbsp;·&nbsp; Số liệu ngày: <strong>@(string.IsNullOrEmpty(NgayBaoCaoDT) ? "Chưa có dữ liệu" : NgayBaoCaoDT)</strong></p>
  </div>

  @* ── KPI ROW ── *@
  @if(TongThuNoiDia != null || TTRU != null){
    var pctN = TongThuNoiDia != null && TongThuNoiDia.KeHoach > 0 ? Math.Round(TongThuNoiDia.ThucHien/TongThuNoiDia.KeHoach*100,1) : 0d;
    var pctR = TTRU != null && TTRU.KeHoach > 0 ? Math.Round(TTRU.ThucHien/TTRU.KeHoach*100,1) : 0d;
    string pc(double v) => v>=90?"g":v>=70?"w":"b";
    <div class="row g-3 mb-3">
      @if(TongThuNoiDia != null){
        <div class="col-6 col-md-3">
          <div class="kc" style="--cc:#3b82f6" onclick="goDT('@TongThuNoiDia.MaChiTieu')">
            <div class="kc-ico"><i class="mdi mdi-bank-outline"></i></div>
            <div class="kc-lbl">Tổng thu nội địa</div>
            <div class="kc-val">@TongThuNoiDia.ThucHien.ToString("N0",nfi)</div>
            <div class="kc-dvt">@TongThuNoiDia.DonViTinh</div>
            <span class="kc-pct @pc(pctN)"><i class="mdi mdi-trending-up"></i> @pctN% KH</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="kc" style="--cc:#10b981">
            <div class="kc-ico"><i class="mdi mdi-target"></i></div>
            <div class="kc-lbl">Kế hoạch năm</div>
            <div class="kc-val">@TongThuNoiDia.KeHoach.ToString("N0",nfi)</div>
            <div class="kc-dvt">@TongThuNoiDia.DonViTinh</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="kc" style="--cc:#f59e0b">
            <div class="kc-ico"><i class="mdi mdi-clock-minus-outline"></i></div>
            <div class="kc-lbl">Còn lại</div>
            <div class="kc-val">@Math.Max(TongThuNoiDia.Conlai,0).ToString("N0",nfi)</div>
