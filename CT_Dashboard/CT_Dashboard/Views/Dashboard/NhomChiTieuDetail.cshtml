@model List<CT_Dashboard.Models.ChiTieuDetailViewModel>

@{
    ViewBag.Title = "Chi tiết nhóm chỉ tiêu: " + (ViewBag.TenNhomChiTieu ?? "");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- DataTables CSS -->
<link href="@Url.Content("~/Content/assets/css/dataTables.bootstrap5.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/Content/assets/css/responsive.bootstrap5.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/Content/assets/css/buttons.bootstrap5.min.css")" rel="stylesheet" />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title mb-0">
                            <i class="mdi mdi-format-list-bulleted-type text-primary"></i>
                            Chi tiết nhóm chỉ tiêu: @ViewBag.TenNhomChiTieu
                        </h4>
                        <small class="text-muted">Mã nhóm: @ViewBag.MaNhomChiTieu</small>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.close()">
                            <i class="mdi mdi-close"></i> Đóng
                        </button>
                        <a href="@Url.Action("Dashboard", "Dashboard")" class="btn btn-primary btn-sm">
                            <i class="mdi mdi-arrow-left"></i> Quay lại Dashboard
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <strong>Thông báo:</strong> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    else if (Model != null && Model.Any())
                    {
                        <!-- Thống kê tổng quan theo từng chỉ tiêu -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="mb-3">
                                    <i class="mdi mdi-chart-bar text-info"></i>
                                    Tổng quan theo chỉ tiêu
                                </h5>
                            </div>
                        </div>
                        
                            var chiTieuGroups = Model.GroupBy(x => x.MaChiTieu).ToList();
                       
                        <div class="row mb-4">
                            @foreach (var group in chiTieuGroups)
                            {
                                var tongThucHien = group.Sum(x => x.ThucHien);
                                var tongKeHoach = group.Sum(x => x.KeHoach);
                                var tyLeHoanThanh = tongKeHoach != 0 ? Math.Round((double)tongThucHien * 100 / tongKeHoach, 2) : 0;
                                var cssClass = tyLeHoanThanh >= 100 ? "bg-success" :
                                              tyLeHoanThanh >= 80 ? "bg-info" :
                                              tyLeHoanThanh >= 50 ? "bg-warning" : "bg-danger";

                                <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                    <div class="card @cssClass text-white h-100">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1 font-weight-bold">@group.First().TenDayDu</h6>
                                                    <p class="mb-1 small">@tongThucHien.ToString("N0")</p>
                                                    <!--<p class="mb-1 small">Thực hiện: @tongThucHien.ToString("N0")</p>
                                                    <p class="mb-1 small">Kế hoạch: @tongKeHoach.ToString("N0")</p>
                                                    <h5 class="mb-0">@tyLeHoanThanh.ToString("F1")%</h5>-->
                                                </div>
                                                <div class="flex-shrink-0">
                                                    <i class="mdi mdi-chart-pie font-size-24"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Bảng chi tiết tổng hợp -->
                        <div class="mb-4">
                            <h5 class="mb-3">
                                <i class="mdi mdi-table text-info"></i>
                                Chi tiết tất cả chỉ tiêu
                            </h5>
                            <div class="table-responsive">
                                <table id="nhomChiTieuDetailTable" class="table table-striped table-bordered dt-responsive nowrap" style="width:100%">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>STT</th>
                                            <th>Chỉ tiêu</th>
                                            <th>Địa bàn</th>
                                            <th>Đơn vị</th>
                                            <th class="text-wrap">Tháng/Năm</th>
                                            <th class="text-wrap">Ngày báo cáo</th>
                                            <th class="text-wrap">Số liệu báo cáo</th>
                                            <!--<th class="text-wrap">Thực hiện lũy kế</th>
                                            <th class="text-wrap">Kế hoạch</th>
                                            <th class="text-wrap">Còn lại</th>
                                            <th>Tỷ lệ (%)</th>
                                            <th class="text-wrap">Cùng kỳ</th>
                                            <th class="text-wrap">So với cùng kỳ (%)</th>
                                            <th>Trạng thái</th>-->
                                            <th class="text-wrap">Đơn vị tính</th>
                                            <th>Chi tiết</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{var index = 1;}
                                        @foreach (var item in Model.OrderBy(x => x.TenChiTieu).ThenBy(x => x.TenDiaBan))
                                        {
                                            <tr>
                                                <td>@index</td>
                                                <td class="text-wrap">
                                                    <strong>@item.TenDayDu</strong>
                                                    <br>
                                                    <small class="text-muted">@item.MaChiTieu</small>
                                                </td>
                                                <td class="text-wrap">@item.TenDiaBan</td>
                                                <td>@item.DonVi</td>
                                                <td>@item.Thang/@item.Nam</td>
                                                <td>@item.NgayBaoCao.ToString("dd/MM/yyyy")</td>
                                                <td class="text-end">@item.ThucHien.ToString("N0")</td>
                                                <!--<td class="text-end">@item.ThucHien.ToString("N0")</td>
                                                <td class="text-end">@item.KeHoach.ToString("N0")</td>
                                                <td class="text-end @(item.ConLai > 0 ? "text-warning" : "text-success")">@item.ConLai.ToString("N0")</td>
                                                <td class="text-end">
                                                    <span class="badge @(item.TyLeHoanThanh >= 100 ? "bg-success" : item.TyLeHoanThanh >= 80 ? "bg-info" : item.TyLeHoanThanh >= 50 ? "bg-warning" : "bg-danger")">
                                                        @item.TyLeHoanThanh.ToString("F2")%
                                                    </span>
                                                </td>
                                                <td class="text-end">@item.CungKy.ToString("N0")</td>
                                                <td class="text-end @(item.SoVoiCungKy >= 0 ? "text-success" : "text-danger")">
                                                    @(item.SoVoiCungKy > 0 ? "+" : "")@item.SoVoiCungKy.ToString("F2")%
                                                </td>
                                                <td class="text-wrap">
                                                    <span class="@item.CssClassTrangThai">
                                                        <i class="mdi @(item.TyLeHoanThanh >= 100 ? "mdi-check-circle" : item.TyLeHoanThanh >= 80 ? "mdi-clock-outline" : item.TyLeHoanThanh >= 50 ? "mdi-alert-outline" : "mdi-close-circle")"></i>
                                                        @item.TrangThaiHoanThanh
                                                    </span>
                                                </td>-->
                                                <td>@item.DonViTinh</td>
                                                <td class="text-wrap">@(string.IsNullOrEmpty(item.GhiChu) ? "" : item.GhiChu)</td>
                                            </tr>
                                            index++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Bảng tổng hợp theo chỉ tiêu -->
                        <div class="mb-4">
                            <h5 class="mb-3">
                                <i class="mdi mdi-chart-donut text-info"></i>
                                Tổng hợp theo từng chỉ tiêu
                            </h5>
                            <div class="table-responsive">
                                <table id="summaryTable" class="table table-bordered table-hover">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>STT</th>
                                            <th>Chỉ tiêu</th>
                                            <th class="text-wrap">Số địa bàn</th>
                                            <th class="text-wrap">Tổng thực hiện</th>
                                            <!--<th class="text-wrap">Tổng kế hoạch</th>
                                            <th class="text-wrap">Tổng còn lại</th>
                                            <th class="text-wrap">Tỷ lệ hoàn thành (%)</th>
                                            <th class="text-wrap">Tổng cùng kỳ</th>
                                            <th class="text-wrap">So với cùng kỳ (%)</th>
                                            <th>Trạng thái</th>-->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{var summaryIndex = 1;}
                                        @foreach (var group in chiTieuGroups.OrderBy(g => g.First().TenChiTieu))
                                        {
                                            var tongThucHien = group.Sum(x => x.ThucHien);
                                            var tongKeHoach = group.Sum(x => x.KeHoach);
                                            var tongConLai = tongKeHoach - tongThucHien;
                                            var tyLeHoanThanh = tongKeHoach != 0 ? Math.Round((double)tongThucHien * 100 / tongKeHoach, 2) : 0;
                                            var tongCungKy = group.Sum(x => x.CungKy);
                                            var soVoiCungKy = tongCungKy != 0 ? Math.Round((double)tongThucHien * 100 / tongCungKy - 100, 2) : 0;

                                            <tr>
                                                <td>@summaryIndex</td>
                                                <td class="text-wrap">
                                                    <strong>@group.First().TenDayDu</strong>
                                                    <br>
                                                    <small class="text-muted">@group.Key</small>
                                                </td>
                                                <td class="text-center">@group.Count()</td>
                                                <td class="text-end">@tongThucHien.ToString("N0")</td>
                                                <!--<td class="text-end">@tongKeHoach.ToString("N0")</td>
                                                <td class="text-end @(tongConLai > 0 ? "text-warning" : "text-success")">@tongConLai.ToString("N0")</td>
                                                <td class="text-center">
                                                    <span class="badge @(tyLeHoanThanh >= 100 ? "bg-success" : tyLeHoanThanh >= 80 ? "bg-info" : tyLeHoanThanh >= 50 ? "bg-warning" : "bg-danger")">
                                                        @tyLeHoanThanh.ToString("F2")%
                                                    </span>
                                                </td>
                                                <td class="text-end">@tongCungKy.ToString("N0")</td>
                                                <td class="text-end @(soVoiCungKy >= 0 ? "text-success" : "text-danger")">
                                                    @(soVoiCungKy > 0 ? "+" : "")@soVoiCungKy.ToString("F2")%
                                                </td>
                                                <td class="text-center text-wrap">
                                                    <span class="@(tyLeHoanThanh >= 100 ? "text-success" : tyLeHoanThanh >= 80 ? "text-info" : tyLeHoanThanh >= 50 ? "text-warning" : "text-danger")">
                                                        <i class="mdi @(tyLeHoanThanh >= 100 ? "mdi-check-circle" : tyLeHoanThanh >= 80 ? "mdi-clock-outline" : tyLeHoanThanh >= 50 ? "mdi-alert-outline" : "mdi-close-circle")"></i>
                                                        @(tyLeHoanThanh >= 100 ? "Đã hoàn thành" : tyLeHoanThanh >= 80 ? "Sắp hoàn thành" : tyLeHoanThanh >= 50 ? "Đang thực hiện" : "Chậm tiến độ")
                                                    </span>
                                                </td>-->
                                            </tr>
                                            summaryIndex++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center" role="alert">
                            <i class="mdi mdi-information-outline font-size-24"></i>
                            <h5 class="mt-2">Không có dữ liệu</h5>
                            <p class="mb-0">Hiện tại chưa có dữ liệu cho nhóm chỉ tiêu này.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables JS -->
    <script src="@Url.Content("~/Content/assets/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.responsive.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/responsive.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/dataTables.buttons.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/buttons.bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/jszip.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/vfs_fonts.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/buttons.html5.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/buttons.print.min.js")"></script>

    <script>
        $(document).ready(function () {
            // DataTable cho bảng chi tiết
            $('#nhomChiTieuDetailTable').DataTable({
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="mdi mdi-file-excel"></i> Excel',
                        className: 'btn btn-success btn-sm'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="mdi mdi-file-pdf"></i> PDF',
                        className: 'btn btn-danger btn-sm'
                    },
                    {
                        extend: 'print',
                        text: '<i class="mdi mdi-printer"></i> In',
                        className: 'btn btn-info btn-sm'
                    }
                ],
                language: {
                    "sEmptyTable": "Không có dữ liệu trong bảng",
                    "sInfo": "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                    "sInfoEmpty": "Hiển thị 0 đến 0 của 0 dòng",
                    "sInfoFiltered": "(được lọc từ _MAX_ dòng)",
                    "sLengthMenu": "Hiển thị _MENU_ dòng",
                    "sLoadingRecords": "Đang tải...",
                    "sProcessing": "Đang xử lý...",
                    "sSearch": "Tìm kiếm:",
                    "sZeroRecords": "Không tìm thấy kết quả",
                    "oPaginate": {
                        "sFirst": "Đầu",
                        "sLast": "Cuối",
                        "sNext": "Tiếp",
                        "sPrevious": "Trước"
                    }
                },
                pageLength: 25,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "Tất cả"]],
                //order: [[1, 'asc'], [4, 'desc']], // Sắp xếp theo chỉ tiêu, sau đó theo tháng/năm
                columnDefs: [
                    { targets: [6], className: 'text-end' }, // Căn phải các cột số
                    { targets: [8], className: 'text-left' }, // Căn giữa cột tỷ lệ
                    //{ targets: [13], className: 'text-center' }, // Căn giữa cột trạng thái
                    //{ targets: [0], orderable: false } // Không cho phép sắp xếp cột STT
                ]
            });

            // DataTable cho bảng tổng hợp
            $('#summaryTable').DataTable({
                responsive: true,
                paging: false,
                info: false,
                searching: false,
                language: {
                    "sEmptyTable": "Không có dữ liệu trong bảng"
                },
                //order: [[6, 'desc']], // Sắp xếp theo tỷ lệ hoàn thành giảm dần
                columnDefs: [
                    { targets: [2], className: 'text-center' }, // Căn giữa cột số địa bàn
                    //{ targets: [3, 4, 5, 7], className: 'text-end' }, // Căn phải các cột số
                    { targets: [3], className: 'text-center' }, // Căn giữa các cột phần trăm và trạng thái
                    //{ targets: [0], orderable: false } // Không cho phép sắp xếp cột STT
                ]
            });
        });
    </script>
}

@section Styles {
    <style>
        .card {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .table-responsive {
            border-radius: 8px;
            overflow: hidden;
        }

        .badge {
            font-size: 0.75em;
            padding: 0.375rem 0.75rem;
        }

        .btn-outline-secondary:hover {
            color: #fff;
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.375rem 0.75rem;
            margin: 0 0.125rem;
            border-radius: 0.25rem;
        }

        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
            padding: 0.375rem 0.75rem;
        }

        .dt-buttons {
            margin-bottom: 1rem;
        }

        .dt-button {
            margin-right: 0.5rem !important;
            border-radius: 0.25rem !important;
        }

        .h-100 {
            height: 100% !important;
        }

        .font-size-24 {
            font-size: 1.5rem !important;
        }

        @@media (max-width: 768px) {
            .card-header {
                flex-direction: column;
                align-items: flex-start !important;
            }

            .card-header > div:last-child {
                margin-top: 1rem;
                width: 100%;
            }

            .col-xl-3, .col-md-4, .col-sm-6 {
                margin-bottom: 1rem;
            }
        }
    </style>
}