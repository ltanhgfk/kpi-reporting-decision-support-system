@model CT_Dashboard.Models.BAO_CAO
@{
    ViewBag.Title = "Sửa Báo Cáo";
}
<div class="container">
    <h2 class="text-center">CẬP NHẬT BÁO CÁO</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
<div class="container">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.Label("TEN_BC", "Tên báo cáo")
        @Html.EditorFor(model => model.TEN_BC, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.TEN_BC, "", new { @class = "text-danger ml-2" })
    </div>
    <div class="form-group">
        @Html.Label("NAM", "Năm")
        @Html.EditorFor(model => model.NAM, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.NAM, "", new { @class = "text-danger ml-2" })
    </div>
    <div class="form-group">
        @Html.Label("THANG", "Tháng")
        @Html.EditorFor(model => model.THANG, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.THANG, "", new { @class = "text-danger ml-2" })
    </div>
    @*<div class="form-group">
            @Html.Label("NGAY", "Ngày")
            @Html.EditorFor(model => model.NGAY, new { htmlAttributes = new { @class = "form-control", type = "date" } })
            @Html.TextBoxFor(model => model.NGAY, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(model => model.NGAY, "", new { @class = "text-danger ml-2" })
        </div>*@
    <div class="form-group">
        @Html.Label("NGAY", "Ngày")
        @Html.EditorFor(model => model.NGAY, new { htmlAttributes = new { @class = "form-control", type = "date", @Value = DateTime.Now.ToString("yyyy-MM-dd") } })
        @Html.ValidationMessageFor(model => model.NGAY, "", new { @class = "text-danger" })
    </div>   
   
    <div class="form-group">
        @Html.Label("DIEN_GIAI", "Diễn giải")
        @Html.TextAreaFor(model => model.DIEN_GIAI, new { @class = "form-control", rows = 3 })
        @Html.ValidationMessageFor(model => model.DIEN_GIAI, "", new { @class = "text-danger ml-2" })
    </div>
    <div class="form-group">
        <div class="btn-save">
            <input type="submit" value="Lưu" class="btn btn-success" />
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary ml-2" })
        </div>
    </div>
</div>
    }
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
@section styles {
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/style.css")">
    <style>
        .form-group {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

            .form-group label {
                width: 180px;
                margin-bottom: 0;
                font-weight: normal;
            }

            .form-group .form-control {
                flex: 1;
            }

        .btn-save {
            margin-left: 180px;
        }
    </style>
}