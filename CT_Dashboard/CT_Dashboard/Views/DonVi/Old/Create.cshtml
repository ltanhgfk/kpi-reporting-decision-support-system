                @Html.LabelFor(model => model.PARENTID)
                
                    @Html.DropDownList("PARENTID", null, "Không có", htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.PARENTID)
                
            </div>*@
            <div class="form-group">
                @Html.LabelFor(model => model.VI_TRI)
                
                    @Html.EditorFor(model => model.VI_TRI, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.VI_TRI)
                
            </div>
            @*<div class="form-group">
                @Html.LabelFor(model => model.GHI_CHU)
                
                    @Html.EditorFor(model => model.GHI_CHU, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.GHI_CHU)
                
            </div>*@
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Thêm" class="btn btn-primary" />
                    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    }
    </div>

    @section styles {
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="../Content/assets/css/style.css">
