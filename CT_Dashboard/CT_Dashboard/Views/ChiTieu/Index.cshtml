@model PagedList.IPagedList<CT_Dashboard.Models.CHI_TIEU>
@using CT_Dashboard.Models;
@using PagedList.Mvc;


@{
    ViewBag.Title = "Quản lý Chỉ tiêu";
    int i = 0;
}

<div class="container">
    <h2 class="text-center">QUẢN LÝ CHỈ TIÊU</h2>
    <div class="row">
        <div class="col-lg-8"><a href="@Url.Action("Create")" class="btn btn-primary mb-3">Thêm mới</a>
                              <a href="@Url.Action("Import")" class="btn btn-primary mb-3">Nhập dữ liệu từ excel</a>
        </div>
        <div class="col-lg-4">
            @using (Html.BeginForm("Index", "ChiTieu", FormMethod.Get, new { @class = "form-inline mb-3" }))
            {
                <div class="form-group">
                    <label for="searchString" class="mr-2">Tìm kiếm:</label>
                    <input type="text" name="searchString" class="form-control mr-2" value="@ViewBag.SearchString" placeholder="Mã hoặc Tên chỉ tiêu" />
                    <button type="submit" class="btn btn-info">Lọc</button>
                </div>
            }
        </div>
    </div>

    <table class="table table-bordered">
        <tr>
            <th>STT</th>
            <th class="text-wrap text-break">Mã Chỉ tiêu</th>
            <th>Tên Chỉ tiêu</th>
            <th>Nhóm chỉ tiêu</th>
            <th class="text-wrap text-break">Đơn vị tính</th>
            <th>Vị trí</th>
            <th class="text-wrap text-break">Đơn vị cập nhật</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
        @foreach (var item in Model)
        {
            i = i + 1;
            CT_DASHBOARDEntities db = new CT_DASHBOARDEntities();
            <tr>
                <td>@i</td>
                <td>@item.MA_CHI_TIEU</td>
                <td class="text-wrap text-break">@item.TEN_CHI_TIEU</td>
                <td class="text-wrap text-break">@(item.PARENTID != "0" ? db.CHI_TIEU.Find(item.PARENTID)?.TEN_CHI_TIEU : "Gốc")</td>
                <td>@item.DVT</td>
                <td>@item.VI_TRI</td>
                <td>@item.DON_VI</td>
                <td>@item.TRANG_THAI</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-warning" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ID }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </table>
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewBag.SearchString }))
    <link href="~/Content/PagedList.css" rel="stylesheet" />
</div>
    @section styles {
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="../Content/assets/css/style.css">
    }
