@model CT_Dashboard.Models.CHI_TIEU
@using CT_Dashboard.Models;
@{
    ViewBag.Title = "Xóa Chỉ tiêu";
    CT_DASHBOARDEntities db = new CT_DASHBOARDEntities();
}
<h2>Xóa Chỉ tiêu</h2>
<h3>Bạn có chắc chắn muốn xóa chỉ tiêu này?</h3>
<div>
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.MA_CHI_TIEU)</dt>
        <dd>@Html.DisplayFor(model => model.MA_CHI_TIEU)</dd>
        <dt>@Html.DisplayNameFor(model => model.TEN_CHI_TIEU)</dt>
        <dd>@Html.DisplayFor(model => model.TEN_CHI_TIEU)</dd>
        <dt>@Html.DisplayNameFor(model => model.PARENTID)</dt>
        <dd>@(Model.PARENTID !=null ? db.DON_VI.Find(Model.PARENTID)?.TEN_DON_VI : "Không có")</dd>
        <dt>@Html.DisplayNameFor(model => model.DVT)</dt>
        <dd>@Html.DisplayFor(model => model.DVT)</dd>
    </dl>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>

@section styles {
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/style.css")">
}