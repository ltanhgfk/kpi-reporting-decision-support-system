# Visual Studio / MSBuild
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pubxml.user

# Build output
[Bb]in/
[Oo]bj/

# NuGet (restored packages are regenerated from packages.config)
packages/
*.nupkg

# Runtime-generated report uploads (contains real submitted organizational data)
# Keep the folder structure but ignore actual uploaded content.
CT_Dashboard/CT_Dashboard/Files/Uploads/*
!CT_Dashboard/CT_Dashboard/Files/Uploads/SampleBaoCao.xlsx
!CT_Dashboard/CT_Dashboard/Files/Uploads/.gitkeep

# App_Data (local SQL Server files, if ever generated locally)
App_Data/*.mdf
App_Data/*.ldf

# Local publish profile history (contains local machine paths)
Properties/PublishProfiles/*.pubxml.user

# OS files
Thumbs.db
.DS_Store
